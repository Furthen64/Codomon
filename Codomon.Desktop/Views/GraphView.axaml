<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:vm="clr-namespace:Codomon.Desktop.ViewModels"
             x:Class="Codomon.Desktop.Views.GraphView"
             x:DataType="vm:GraphViewModel">

  <DockPanel>

    <!-- ── Breadcrumb ───────────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Top"
            Background="#0F141E"
            BorderThickness="0,0,0,1"
            BorderBrush="#2A3F5A"
            Padding="10,6">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button x:Name="BreadcrumbSystemMapButton"
                Content="{Binding BreadcrumbSystemLabel}"
                Padding="8,2"/>
        <TextBlock Text=">" Foreground="#4A6A8A" VerticalAlignment="Center"/>
        <Button x:Name="BreadcrumbModuleButton"
                Content="{Binding BreadcrumbModuleLabel}"
                IsVisible="{Binding ShowModuleBreadcrumb}"
                IsEnabled="{Binding CanNavigateToModule}"
                Padding="8,2"/>
        <TextBlock Text=">" Foreground="#4A6A8A" VerticalAlignment="Center"
                   IsVisible="{Binding ShowModuleBreadcrumb}"/>
        <Button x:Name="BreadcrumbCodeNodesButton"
                Content="{Binding BreadcrumbCodeNodesLabel}"
                IsVisible="{Binding ShowCodeNodesBreadcrumb}"
                IsEnabled="{Binding CanNavigateToCodeNodes}"
                Padding="8,2"/>
        <TextBlock Text=">" Foreground="#4A6A8A" VerticalAlignment="Center"
                   IsVisible="{Binding ShowCodeNodesBreadcrumb}"/>
        <TextBlock Text="Graph" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- ── Canvas Alignment Toolbar ──────────────────────────────────────── -->
    <Border DockPanel.Dock="Top"
            Background="#1A2435"
            BorderThickness="0,0,0,1"
            BorderBrush="#2A3F5A"
            Padding="6,4">
      <StackPanel Orientation="Horizontal" Spacing="8">

        <!-- VIEW group: fit / zoom -->
        <Border BorderBrush="#2A3F5A" BorderThickness="1" CornerRadius="4" Padding="6,3">
          <StackPanel Spacing="3">
            <TextBlock Text="VIEW" FontSize="9" FontWeight="Bold" Foreground="#4A6A8A"
                       LetterSpacing="1" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="3">
              <Button x:Name="FitToViewButton" Content="⊡ Fit"  Padding="7,2"
                      ToolTip.Tip="Fit all nodes into view"/>
              <Button x:Name="ZoomInButton"    Content="+"       Padding="7,2"
                      ToolTip.Tip="Zoom in"/>
              <Button x:Name="ZoomOutButton"   Content="−"       Padding="7,2"
                      ToolTip.Tip="Zoom out"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ALIGN group: align edges / centers of selected nodes -->
        <Border BorderBrush="#2A3F5A" BorderThickness="1" CornerRadius="4" Padding="6,3">
          <StackPanel Spacing="3">
            <TextBlock Text="ALIGN SELECTED" FontSize="9" FontWeight="Bold" Foreground="#4A6A8A"
                       LetterSpacing="1" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="3">
              <Button x:Name="AlignLeftButton"   Content="◀ Left"   Padding="7,2"
                      ToolTip.Tip="Align left edges of selected nodes"/>
              <Button x:Name="AlignRightButton"  Content="Right ▶"  Padding="7,2"
                      ToolTip.Tip="Align right edges of selected nodes"/>
              <Button x:Name="AlignTopButton"    Content="▲ Top"    Padding="7,2"
                      ToolTip.Tip="Align top edges of selected nodes"/>
              <Button x:Name="AlignBottomButton" Content="▼ Bot"    Padding="7,2"
                      ToolTip.Tip="Align bottom edges of selected nodes"/>
              <Button x:Name="CenterHButton"     Content="↕ Ctr H"  Padding="7,2"
                      ToolTip.Tip="Center selected nodes on a shared horizontal axis"/>
              <Button x:Name="CenterVButton"     Content="↔ Ctr V"  Padding="7,2"
                      ToolTip.Tip="Center selected nodes on a shared vertical axis"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ARRANGE group: automatic layout / distribution -->
        <Border BorderBrush="#2A3F5A" BorderThickness="1" CornerRadius="4" Padding="6,3">
          <StackPanel Spacing="3">
            <TextBlock Text="ARRANGE" FontSize="9" FontWeight="Bold" Foreground="#4A6A8A"
                       LetterSpacing="1" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="3">
              <Button x:Name="AutoAlignButton"   Content="⊞ Auto-Align"  Padding="7,2"
                      ToolTip.Tip="Arrange all nodes left-to-right in connection order, then fit to view"/>
              <Button x:Name="DistributeHButton" Content="⇔ Space H"     Padding="7,2"
                      ToolTip.Tip="Evenly distribute selected nodes along the horizontal axis (select 3 or more)"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- FILTER group: confidence + relationship-kind toggles -->
        <Border BorderBrush="#2A3F5A" BorderThickness="1" CornerRadius="4" Padding="6,3">
          <StackPanel Spacing="3">
            <TextBlock Text="FILTER" FontSize="9" FontWeight="Bold" Foreground="#4A6A8A"
                       LetterSpacing="1" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <CheckBox x:Name="FilterLowConfidenceCheck" Content="Low Conf"
                        FontSize="11" Foreground="#AABBCC"
                        ToolTip.Tip="Show items with Unknown confidence (hidden by default)"/>
              <CheckBox x:Name="FilterCallsCheck" Content="Calls"
                        IsChecked="True" FontSize="11" Foreground="#AABBCC"
                        ToolTip.Tip="Show Calls relationships"/>
              <CheckBox x:Name="FilterDependsCheck" Content="Depends"
                        IsChecked="True" FontSize="11" Foreground="#AABBCC"
                        ToolTip.Tip="Show Depends relationships"/>
              <CheckBox x:Name="FilterImportsCheck" Content="Imports"
                        IsChecked="True" FontSize="11" Foreground="#AABBCC"
                        ToolTip.Tip="Show Imports relationships"/>
              <CheckBox x:Name="FilterOtherKindsCheck" Content="Others"
                        IsChecked="True" FontSize="11" Foreground="#AABBCC"
                        ToolTip.Tip="Show all other relationship kinds (Configures, Logs, Hosts, …)"/>
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </Border>

    <!-- ── Graph Info Panel ──────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Top"
            Background="#141C28"
            BorderThickness="0,0,0,1"
            BorderBrush="#2A3F5A"
            Padding="10,6">
      <StackPanel Spacing="3">
        <TextBlock Text="About this view"
                   FontSize="11" FontWeight="Bold" Foreground="#AABBCC"/>
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#778899">
          <Run>The Graph view displays your workspace's architecture as an interactive node graph. Each node represents a component (service, library, class, etc.) and each edge represents a relationship between components (Calls, Depends, Imports, etc.).</Run>
        </TextBlock>
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#556677" Margin="0,2,0,0">
          <Run FontWeight="SemiBold" Foreground="#4A8A6A">Sources:</Run>
          <Run> Nodes and connections are populated from Roslyn static-analysis scans, manually added entries, and imported log replays. Use the toolbar above to filter by confidence level or relationship kind, and to arrange nodes automatically.</Run>
        </TextBlock>
      </StackPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="320"/>
      </Grid.ColumnDefinitions>

      <!-- ── Graph Canvas ───────────────────────────────────────────────────── -->
      <Grid Grid.Column="0">
        <nodify:NodifyEditor x:Name="Editor"
                             DisplayConnectionsOnTop="False"
                             ItemsSource="{Binding Nodes}"
                             Connections="{Binding Connections}">

      <!-- Node template: explicit left-side inputs and right-side outputs -->
        <nodify:NodifyEditor.ItemTemplate>
          <DataTemplate x:DataType="vm:NodeViewModel">
            <nodify:Node Input="{Binding Inputs}"
                         Output="{Binding Outputs}"
                         BorderThickness="{Binding BorderThickness}"
                         MinWidth="{Binding NodeMinWidth}"
                         PointerPressed="OnNodePointerPressed">

              <nodify:Node.Header>
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               FontSize="{Binding TitleFontSize}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="●"
                               IsVisible="{Binding IsCodeLeaf}"
                               FontSize="{Binding LeafIndicatorFontSize}"
                               Foreground="#8BD4FF"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Background="{Binding KindBadgeBackground}" CornerRadius="3" Padding="5,2">
                      <TextBlock Text="{Binding KindLabel}" FontSize="{Binding BadgeFontSize}"
                                 Foreground="{Binding KindBadgeForeground}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding Subtitle}" FontSize="{Binding SubtitleFontSize}" Foreground="#8FA5BC"
                               VerticalAlignment="Center"
                               MaxWidth="{Binding SubtitleMaxWidth}"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </StackPanel>
              </nodify:Node.Header>

            <!-- Each input connector rendered as a NodeInput on the left -->
            <nodify:Node.InputConnectorTemplate>
              <DataTemplate x:DataType="vm:ConnectorViewModel">
                <nodify:NodeInput Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                  IsConnected="{Binding IsConnected}" />
              </DataTemplate>
            </nodify:Node.InputConnectorTemplate>

            <!-- Each output connector rendered as a NodeOutput on the right -->
            <nodify:Node.OutputConnectorTemplate>
              <DataTemplate x:DataType="vm:ConnectorViewModel">
                <nodify:NodeOutput Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                   IsConnected="{Binding IsConnected}" />
              </DataTemplate>
            </nodify:Node.OutputConnectorTemplate>

            </nodify:Node>
          </DataTemplate>
        </nodify:NodifyEditor.ItemTemplate>

      <!-- Position each ItemContainer at the node's Location.
           ReflectionBinding is used because ControlTheme bindings cannot resolve
           the DataContext type statically when compiled bindings are enabled globally. -->
        <nodify:NodifyEditor.ItemContainerTheme>
          <ControlTheme TargetType="nodify:ItemContainer" BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
            <Setter Property="Location" Value="{ReflectionBinding Location}" />
          </ControlTheme>
        </nodify:NodifyEditor.ItemContainerTheme>

      <!-- Connection template: cubic bezier curve; Label is shown as a tooltip. -->
        <nodify:NodifyEditor.ConnectionTemplate>
          <DataTemplate x:DataType="vm:ConnectionViewModel">
            <nodify:Connection Source="{Binding Source}"
                               Target="{Binding Target}"
                               Stroke="{Binding Stroke}"
                               StrokeThickness="{Binding StrokeThickness}"
                               ToolTip.Tip="{Binding Label}" />
          </DataTemplate>
        </nodify:NodifyEditor.ConnectionTemplate>

        </nodify:NodifyEditor>

        <Border IsVisible="{Binding ShowEmptyState}"
                IsHitTestVisible="True"
                Background="#E60F141E"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MaxWidth="460"
                      Spacing="12">
            <TextBlock Text="Nothing to show here yet"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#E7EEF9"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding EmptyStateMessage}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="#9DB2C7"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8">
              <Button x:Name="RevealLowConfidenceButton"
                      Content="Reveal low-confidence items"
                      IsVisible="{Binding CanRevealLowConfidenceItems}"
                      Click="OnRevealLowConfidenceClick"
                      Padding="12,7"/>
              <Button x:Name="OpenAnalyzeButton"
                      Content="Open Analyze"
                      Click="OnOpenAnalyzeClick"
                      Padding="12,7"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ── Node details panel ───────────────────────────────────────────── -->
      <Border Grid.Column="1" Background="#141C28" BorderBrush="#2A3F5A" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10" Spacing="8">
            <TextBlock Text="Node details" FontWeight="SemiBold" Foreground="#AABBCC"/>
            <TextBlock Text="{Binding SelectedNodeName}" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>

            <StackPanel IsVisible="{Binding HasSelectedNode}" Spacing="6">
              <Border Height="1" Background="#2A3F5A"/>
              <TextBlock Text="{Binding SelectedNodeType}" Foreground="#88AABB"/>
              <TextBlock Text="{Binding SelectedNodeKind}" Foreground="#AABBCC"/>
              <TextBlock Text="{Binding SelectedNodeFullName}" Foreground="#778899" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding SelectedNodeConfidence}" Foreground="#778899"/>
              <TextBlock Text="{Binding SelectedNodeSystem}" Foreground="#778899"/>
              <TextBlock Text="{Binding SelectedNodeModule}" Foreground="#778899"/>

              <Border Height="1" Background="#2A3F5A" Margin="0,4,0,0"/>
              <TextBlock Text="Node size" Foreground="#AABBCC" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="−"
                        Click="OnDecreaseNodeSizeClick"
                        IsEnabled="{Binding CanDecreaseSelectedNodeSize}"
                        Padding="8,2"/>
                <TextBlock Text="{Binding SelectedNodeSizePercent}"
                           Foreground="#AABBCC"
                           VerticalAlignment="Center"/>
                <Button Content="+"
                        Click="OnIncreaseNodeSizeClick"
                        IsEnabled="{Binding CanIncreaseSelectedNodeSize}"
                        Padding="8,2"/>
              </StackPanel>

              <Border Height="1" Background="#2A3F5A" Margin="0,4,0,0"/>
              <TextBlock Text="Files" Foreground="#AABBCC" FontWeight="SemiBold"/>
              <ItemsControl ItemsSource="{Binding SelectedNodeFiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GraphNodeFileVm">
                    <Button Content="{Binding DisplayName}"
                            Tag="{Binding FullPath}"
                            Click="OnFileClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="6,3"
                            Margin="0,2,0,0"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel IsVisible="{Binding HasSelectedNodeCallers}" Spacing="4" Margin="0,8,0,0">
                <Border Height="1" Background="#2A3F5A"/>
                <TextBlock Text="Called by" Foreground="#AABBCC" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding SelectedNodeCallers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GraphCallerVm">
                      <Button Tag="{Binding ModuleId}"
                              Click="OnCallerCardClick"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Padding="8,6"
                              Margin="0,2,0,0">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding CallerName}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding CallerContext}"
                                     FontSize="10"
                                     Foreground="#8FA5BC"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel IsVisible="{Binding HasSelectedNodeSummary}" Spacing="4" Margin="0,8,0,0">
                <Border Height="1" Background="#2A3F5A"/>
                <TextBlock Text="Summary" Foreground="#AABBCC" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedNodeSummaryFirstParagraph}"
                           Foreground="#9BB4CC"
                           FontSize="11"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

  </DockPanel>

</UserControl>
