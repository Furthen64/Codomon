<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Codomon.Desktop.Views.SystemMapView">

  <DockPanel>

    <!-- ── Toolbar: view selector + filters ──────────────────────────────── -->
    <Border DockPanel.Dock="Top"
            Background="#1A2435"
            BorderThickness="0,0,0,1"
            BorderBrush="#2A3F5A"
            Padding="6,4">
      <DockPanel>

        <!-- Map layout -->
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="LAYOUT:" VerticalAlignment="Center"
                     Foreground="#4A6A8A" FontSize="9" FontWeight="Bold"
                     LetterSpacing="1" Margin="0,0,4,0"/>
          <ComboBox x:Name="LayoutViewComboBox" SelectedIndex="1" MaxHeight="28" MinWidth="120">
            <ComboBoxItem Content="Layered View"/>
            <ComboBoxItem Content="Flat View"/>
            <ComboBoxItem Content="Compact View"/>
          </ComboBox>
        </StackPanel>

        <!-- Filters -->
        <StackPanel Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="FILTERS:" VerticalAlignment="Center"
                     Foreground="#4A6A8A" FontSize="9" FontWeight="Bold"
                     LetterSpacing="1" Margin="0,0,4,0"/>
          <CheckBox x:Name="CbShowExternal"     Content="External Systems" IsChecked="True"/>
          <CheckBox x:Name="CbShowLowConf"      Content="Low Confidence"   IsChecked="True"/>
          <CheckBox x:Name="CbHighValueOnly"    Content="High Value Only"  IsChecked="False"/>
          <CheckBox x:Name="CbShowStartupEdges" Content="Startup Edges"    IsChecked="False"/>
        </StackPanel>

      </DockPanel>
    </Border>

    <!-- ── Main: content area + inspector panel ───────────────────────────── -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="260" MinWidth="180"/>
      </Grid.ColumnDefinitions>

      <!-- Column splitter -->
      <GridSplitter Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Background="#2A3F5A"
                    ResizeDirection="Columns"/>

      <!-- ── Content area (all 4 views stacked; only one visible at a time) ── -->
      <Border Grid.Column="0" Background="#0F141E" ClipToBounds="True">
        <Grid>

          <!-- System Overview panel -->
          <ScrollViewer x:Name="PanelSystemOverview" IsVisible="True"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12" Spacing="16">

              <TextBlock x:Name="EmptySystemOverviewText"
                         Text="No Systems found. Use Architecture Hypothesis to detect systems from your codebase."
                         Foreground="#556677" FontSize="13" TextWrapping="Wrap"
                         IsVisible="False"/>

              <StackPanel x:Name="SystemsSection" Spacing="10">
                <TextBlock Text="SYSTEMS" FontSize="9" FontWeight="Bold"
                           Foreground="#4A6A8A" LetterSpacing="1"/>
                <LayoutTransformControl x:Name="CanvasZoomControl">
                  <Border Background="Transparent" MinHeight="600">
                    <Canvas x:Name="SystemsCanvas"/>
                  </Border>
                </LayoutTransformControl>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>

          <!-- Module View panel -->
          <DockPanel x:Name="PanelModuleView" IsVisible="False">
            <Border DockPanel.Dock="Top" Background="#141C28"
                    Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
              <DockPanel>
                <Button Content="← Map"
                        Click="OnReturnToMapClick"
                        Padding="8,3"
                        Margin="0,0,10,0"
                        ToolTip.Tip="Return to the system map."/>
                <TextBlock x:Name="ModuleViewHeader" Foreground="#AABBCC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="ShowDetailedRelationshipsButton"
                        DockPanel.Dock="Right"
                        Content="Show detailed relationships"
                        Click="OnShowDetailedRelationshipsClick"
                        Padding="10,4"
                        Margin="10,0,0,0"
                        ToolTip.Tip="Open the Graph tab with module-to-module relationships for the selected system."/>
              </DockPanel>
            </Border>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="26,22" Spacing="18">
                <TextBlock x:Name="NoModulesText"
                           Text="No modules found for the selected system."
                           Foreground="#445566" FontSize="11" IsVisible="False"/>
                <Grid x:Name="ModuleViewSurface"
                      Margin="8">
                  <Canvas x:Name="ModuleRelationshipsCanvas"
                          IsHitTestVisible="True"
                          ZIndex="0"/>
                  <ItemsControl x:Name="ModulesItemsControl"
                                ZIndex="1">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <!-- Code Detail View panel -->
          <DockPanel x:Name="PanelCodeDetail" IsVisible="False">
            <Border DockPanel.Dock="Top" Background="#141C28"
                    Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
              <DockPanel>
                <Button Content="← Map"
                        Click="OnReturnToMapClick"
                        Padding="8,3"
                        Margin="0,0,10,0"
                        ToolTip.Tip="Return to the system map."/>
                <TextBlock x:Name="CodeDetailHeader" Foreground="#AABBCC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="ShowCodeNodeRelationshipsButton"
                        DockPanel.Dock="Right"
                        Content="Show detailed relationship"
                        Click="OnShowCodeNodeRelationshipsClick"
                        Padding="10,4"
                        Margin="10,0,0,0"
                        ToolTip.Tip="Open the Graph tab with code-node relationships for the selected module."/>
              </DockPanel>
            </Border>
            <TextBlock x:Name="NoCodeNodesText"
                       Text="No code nodes found for the selected scope."
                       Foreground="#445566" FontSize="11"
                       IsVisible="False" Margin="16,12"/>
            <ListBox x:Name="CodeNodesListBox"
                     Background="Transparent"
                     SelectionChanged="OnCodeNodeSelected"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
          </DockPanel>

          <!-- Startup View panel -->
          <DockPanel x:Name="PanelStartup" IsVisible="False">
            <Border DockPanel.Dock="Top" Background="#141C28"
                    Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
              <Button Content="← Map"
                      Click="OnReturnToMapClick"
                      Padding="8,3"
                      HorizontalAlignment="Left"
                      ToolTip.Tip="Return to the system map."/>
            </Border>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12" Spacing="16">

              <TextBlock x:Name="EmptyStartupText"
                         Text="No startup information available. Systems with startup mechanisms will appear here."
                         Foreground="#556677" FontSize="13" TextWrapping="Wrap"
                         IsVisible="False"/>

              <StackPanel x:Name="StartupItemsSection" Spacing="10">
                <TextBlock Text="STARTUP ORDER" FontSize="9" FontWeight="Bold"
                           Foreground="#4A6A8A" LetterSpacing="1"/>
                <TextBlock Text="Systems are listed roughly in dependency order (dependencies start first)."
                           Foreground="#445566" FontSize="11" TextWrapping="Wrap"/>
                <ItemsControl x:Name="StartupItemsControl"/>
              </StackPanel>

            </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <!-- Zoom overlay — absolutely positioned top-right of content area -->
          <Border x:Name="CanvasZoomOverlay"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="8" Padding="6,4"
                  Background="#CC1A2435"
                  CornerRadius="4"
                  IsHitTestVisible="True">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button x:Name="ZoomOutButton" Content="−" Width="28" Padding="4,2"
                      ToolTip.Tip="Zoom out"/>
              <TextBlock x:Name="ZoomLevelText" Text="100%"
                         VerticalAlignment="Center" Foreground="#AABBCC"
                         FontSize="11" Width="38" TextAlignment="Center"/>
              <Button x:Name="ZoomInButton" Content="+" Width="28" Padding="4,2"
                      ToolTip.Tip="Zoom in"/>
              <Button x:Name="ZoomResetButton" Content="Reset" Padding="8,2"
                      ToolTip.Tip="Reset zoom to 100%"/>
            </StackPanel>
          </Border>

        </Grid>
      </Border>

      <!-- ── Right panel: Component / Connections / Properties tabs ─────────── -->
      <Border Grid.Column="2" Background="#141C28"
              BorderThickness="1,0,0,0" BorderBrush="#2A3F5A">
        <DockPanel>

          <!-- Delete Relationship action (shown when a relationship is selected) -->
          <Border x:Name="InspRelActionPanel" IsVisible="False"
                  DockPanel.Dock="Bottom"
                  Background="#141C28"
                  BorderThickness="0,1,0,0" BorderBrush="#2A3F5A"
                  Padding="8,6">
            <Button x:Name="RemoveRelationshipButton"
                    Content="Delete Relationship"
                    Click="OnRemoveRelationshipClick"
                    HorizontalAlignment="Stretch"
                    Padding="8,4"
                    Background="#3A1A1A"
                    Foreground="#FFAAAA"
                    ToolTip.Tip="Permanently remove this relationship from the System Map."/>
          </Border>

          <!-- Tab control -->
          <TabControl x:Name="RightPanelTabControl"
                      Background="Transparent"
                      Padding="0">

            <!-- ── Component tab ──────────────────────────────────────── -->
            <TabItem Header="Summary" Padding="10,4">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,10" Spacing="6">

                  <!-- Name -->
                  <TextBlock x:Name="CompNameText"
                             Text="Nothing selected"
                             Foreground="White" FontWeight="Bold"
                             FontSize="16" TextWrapping="Wrap"/>

                  <!-- Active badge + Layer tag -->
                  <StackPanel x:Name="CompBadgesPanel" IsVisible="False"
                              Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                    <Border x:Name="CompActiveBadge"
                            Background="#1A3A1A" CornerRadius="10" Padding="8,3">
                      <TextBlock Text="● Active" Foreground="#27AE60"
                                 FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Border x:Name="CompLayerTagBorder"
                            CornerRadius="4" Padding="8,3">
                      <TextBlock x:Name="CompLayerTagText"
                                 FontSize="10" FontWeight="Bold"/>
                    </Border>
                  </StackPanel>

                  <!-- Description -->
                  <TextBlock x:Name="CompDescText"
                             Foreground="#AABBCC" FontSize="12"
                             TextWrapping="Wrap" IsVisible="False"
                             Margin="0,4,0,0"/>

                  <!-- Source section -->
                  <StackPanel x:Name="CompSourcePanel" IsVisible="False" Spacing="2"
                              Margin="0,6,0,0">
                    <Border Height="1" Background="#2A3F5A" Margin="0,0,0,4"/>
                    <TextBlock Text="SOURCE" Foreground="#778899"
                               FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
                    <TextBlock x:Name="CompSourceFileText"
                               Foreground="#88AABB" FontSize="11"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="CompSourceLinesText"
                               Foreground="#778899" FontSize="10"
                               IsVisible="False"/>
                  </StackPanel>

                  <!-- Responsibilities section -->
                  <StackPanel x:Name="CompResponsibilitiesPanel" IsVisible="False"
                              Spacing="4" Margin="0,6,0,0">
                    <Border Height="1" Background="#2A3F5A" Margin="0,0,0,4"/>
                    <TextBlock Text="RESPONSIBILITIES" Foreground="#778899"
                               FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
                    <ItemsControl x:Name="CompResponsibilitiesItemsControl"/>
                  </StackPanel>

                  <!-- Log Points section (placeholder — data not yet available) -->
                  <StackPanel x:Name="CompLogPointsPanel" IsVisible="False"
                              Spacing="4" Margin="0,6,0,0">
                    <Border Height="1" Background="#2A3F5A" Margin="0,0,0,4"/>
                    <TextBlock x:Name="CompLogPointsHeader"
                               Text="LOG POINTS (0)" Foreground="#778899"
                               FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
                  </StackPanel>

                  <!-- Recent Activity section (sparkline placeholder) -->
                  <StackPanel x:Name="CompActivityPanel" IsVisible="False"
                              Spacing="4" Margin="0,6,0,0">
                    <Border Height="1" Background="#2A3F5A" Margin="0,0,0,4"/>
                    <TextBlock Text="RECENT ACTIVITY" Foreground="#778899"
                               FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
                    <Border Height="44" CornerRadius="4"
                            Background="#1A2435"
                            BorderBrush="#2A3F5A" BorderThickness="1">
                      <TextBlock Text="Activity chart coming soon"
                                 Foreground="#445566" FontSize="10"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                  </StackPanel>

                  <!-- View Modules navigation button (visible when a system is selected) -->
                  <Button x:Name="BtnViewModulesFromInspector"
                          IsVisible="False"
                          Content="View Modules →"
                          Click="OnViewModulesFromInspectorClick"
                          HorizontalAlignment="Stretch"
                          Padding="10,6"
                          Margin="0,8,0,0"
                          ToolTip.Tip="Switch to Module View for this system."/>

                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- ── Connections tab ────────────────────────────────────── -->
            <TabItem Header="Relationships" Padding="10,4">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,10" Spacing="6">

                  <TextBlock x:Name="CompConnNothingText"
                             Text="Select a component to see its connections."
                             Foreground="#445566" FontSize="11"
                             TextWrapping="Wrap" IsVisible="True"/>

                  <!-- Outbound connections -->
                  <StackPanel x:Name="CompOutboundPanel" IsVisible="False"
                              Spacing="4" Margin="0,4,0,0">
                    <TextBlock Text="OUTBOUND" Foreground="#778899"
                               FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
                    <ItemsControl x:Name="CompOutboundItemsControl"/>
                  </StackPanel>

                  <!-- Inbound connections -->
                  <StackPanel x:Name="CompInboundPanel" IsVisible="False"
                              Spacing="4" Margin="0,8,0,0">
                    <TextBlock Text="INBOUND" Foreground="#778899"
                               FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
                    <ItemsControl x:Name="CompInboundItemsControl"/>
                  </StackPanel>

                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- ── Properties tab ─────────────────────────────────────── -->
            <TabItem Header="Details" Padding="10,4">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,10" Spacing="6">

                  <TextBlock x:Name="InspNameText"
                             Text="Nothing selected"
                             Foreground="White" FontWeight="SemiBold"
                             FontSize="14" TextWrapping="Wrap"/>

                  <!-- Type row -->
                  <StackPanel x:Name="InspTypePanel" IsVisible="False" Spacing="2">
                    <Border Height="1" Background="#2A3F5A" Margin="0,4,0,4"/>
                    <TextBlock Text="Type" Foreground="#778899" FontSize="10" FontWeight="Bold" LetterSpacing="1"/>
                    <TextBlock x:Name="InspTypeText" Foreground="#AABBCC" TextWrapping="Wrap"/>
                  </StackPanel>

                  <!-- Kind row -->
                  <StackPanel x:Name="InspKindPanel" IsVisible="False" Spacing="2">
                    <TextBlock Text="Kind" Foreground="#778899" FontSize="10" FontWeight="Bold" LetterSpacing="1"/>
                    <TextBlock x:Name="InspKindText" Foreground="#AABBCC" TextWrapping="Wrap"/>
                  </StackPanel>

                  <!-- Confidence row -->
                  <StackPanel x:Name="InspConfPanel" IsVisible="False" Spacing="2">
                    <TextBlock Text="Confidence" Foreground="#778899" FontSize="10" FontWeight="Bold" LetterSpacing="1"/>
                    <TextBlock x:Name="InspConfText" Foreground="#AABBCC"/>
                  </StackPanel>

                  <!-- Notes row -->
                  <StackPanel x:Name="InspNotesPanel" IsVisible="False" Spacing="2">
                    <Border Height="1" Background="#2A3F5A" Margin="0,4,0,4"/>
                    <TextBlock Text="Notes" Foreground="#778899" FontSize="10" FontWeight="Bold" LetterSpacing="1"/>
                    <TextBlock x:Name="InspNotesText" Foreground="#88AABB"
                               TextWrapping="Wrap" FontSize="11"/>
                  </StackPanel>

                  <!-- Details row -->
                  <StackPanel x:Name="InspDetailsPanel" IsVisible="False" Spacing="4">
                    <Border Height="1" Background="#2A3F5A" Margin="0,4,0,4"/>
                    <TextBlock Text="Details" Foreground="#778899" FontSize="10" FontWeight="Bold" LetterSpacing="1"/>
                    <ItemsControl x:Name="InspDetailsItemsControl"/>
                  </StackPanel>

                </StackPanel>
              </ScrollViewer>
            </TabItem>

          </TabControl>

        </DockPanel>
      </Border>

    </Grid>

  </DockPanel>

</UserControl>
