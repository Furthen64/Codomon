<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Codomon.Desktop.Views.SystemMapView">

  <DockPanel>
    <Grid>
      <!-- ── Content area (all 4 views stacked; only one visible at a time) ── -->
      <Border Background="#0F141E" ClipToBounds="True">
        <Grid>

          <!-- System Overview panel -->
          <ScrollViewer x:Name="PanelSystemOverview" IsVisible="True"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12" Spacing="16">

              <TextBlock x:Name="EmptySystemOverviewText"
                         Text="No Systems found. Use Architecture Hypothesis to detect systems from your codebase."
                         Foreground="#556677" FontSize="13" TextWrapping="Wrap"
                         IsVisible="False"/>

              <StackPanel x:Name="SystemsSection" Spacing="10">
                <TextBlock Text="SYSTEMS" FontSize="9" FontWeight="Bold"
                           Foreground="#4A6A8A" LetterSpacing="1"/>
                <LayoutTransformControl x:Name="CanvasZoomControl">
                  <Border Background="Transparent" MinHeight="600">
                    <Canvas x:Name="SystemsCanvas"/>
                  </Border>
                </LayoutTransformControl>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>

          <!-- Module View panel -->
          <DockPanel x:Name="PanelModuleView" IsVisible="False">
            <Border DockPanel.Dock="Top" Background="#141C28"
                    Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
              <DockPanel>
                <Button Content="← Map"
                        Click="OnReturnToMapClick"
                        Padding="8,3"
                        Margin="0,0,10,0"
                        ToolTip.Tip="Return to the system map."/>
                <TextBlock x:Name="ModuleViewHeader" Foreground="#AABBCC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="ShowDetailedRelationshipsButton"
                        DockPanel.Dock="Right"
                        Content="Show detailed relationships"
                        Click="OnShowDetailedRelationshipsClick"
                        Padding="10,4"
                        Margin="10,0,0,0"
                        ToolTip.Tip="Open the Graph tab with module-to-module relationships for the selected system."/>
              </DockPanel>
            </Border>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="26,22" Spacing="18">
                <TextBlock x:Name="NoModulesText"
                           Text="No modules found for the selected system."
                           Foreground="#445566" FontSize="11" IsVisible="False"/>
                <Grid x:Name="ModuleViewSurface"
                      Margin="8">
                  <Canvas x:Name="ModuleRelationshipsCanvas"
                          IsHitTestVisible="True"
                          ZIndex="0"/>
                  <ItemsControl x:Name="ModulesItemsControl"
                                ZIndex="1">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <!-- Code Detail View panel -->
          <DockPanel x:Name="PanelCodeDetail" IsVisible="False">
            <Border DockPanel.Dock="Top" Background="#141C28"
                    Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
              <DockPanel>
                <Button Content="← Map"
                        Click="OnReturnToMapClick"
                        Padding="8,3"
                        Margin="0,0,10,0"
                        ToolTip.Tip="Return to the system map."/>
                <TextBlock x:Name="CodeDetailHeader" Foreground="#AABBCC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="ShowCodeNodeRelationshipsButton"
                        DockPanel.Dock="Right"
                        Content="Show detailed relationship"
                        Click="OnShowCodeNodeRelationshipsClick"
                        Padding="10,4"
                        Margin="10,0,0,0"
                        ToolTip.Tip="Open the Graph tab with code-node relationships for the selected module."/>
              </DockPanel>
            </Border>
            <TextBlock x:Name="NoCodeNodesText"
                       Text="No code nodes found for the selected scope."
                       Foreground="#445566" FontSize="11"
                       IsVisible="False" Margin="16,12"/>
            <ListBox x:Name="CodeNodesListBox"
                     Background="Transparent"
                     SelectionChanged="OnCodeNodeSelected"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
          </DockPanel>

          <!-- Startup View panel -->
          <DockPanel x:Name="PanelStartup" IsVisible="False">
            <Border DockPanel.Dock="Top" Background="#141C28"
                    Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
              <Button Content="← Map"
                      Click="OnReturnToMapClick"
                      Padding="8,3"
                      HorizontalAlignment="Left"
                      ToolTip.Tip="Return to the system map."/>
            </Border>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12" Spacing="16">

              <TextBlock x:Name="EmptyStartupText"
                         Text="No startup information available. Systems with startup mechanisms will appear here."
                         Foreground="#556677" FontSize="13" TextWrapping="Wrap"
                         IsVisible="False"/>

              <StackPanel x:Name="StartupItemsSection" Spacing="10">
                <TextBlock Text="STARTUP ORDER" FontSize="9" FontWeight="Bold"
                           Foreground="#4A6A8A" LetterSpacing="1"/>
                <TextBlock Text="Systems are listed roughly in dependency order (dependencies start first)."
                           Foreground="#445566" FontSize="11" TextWrapping="Wrap"/>
                <ItemsControl x:Name="StartupItemsControl"/>
              </StackPanel>

            </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <!-- Zoom overlay — absolutely positioned top-right of content area -->
          <Border x:Name="CanvasZoomOverlay"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="8" Padding="6,4"
                  Background="#CC1A2435"
                  CornerRadius="4"
                  IsHitTestVisible="True">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button x:Name="ZoomOutButton" Content="−" Width="28" Padding="4,2"
                      ToolTip.Tip="Zoom out"/>
              <TextBlock x:Name="ZoomLevelText" Text="100%"
                         VerticalAlignment="Center" Foreground="#AABBCC"
                         FontSize="11" Width="38" TextAlignment="Center"/>
              <Button x:Name="ZoomInButton" Content="+" Width="28" Padding="4,2"
                      ToolTip.Tip="Zoom in"/>
              <Button x:Name="ZoomResetButton" Content="Reset" Padding="8,2"
                      ToolTip.Tip="Reset zoom to 100%"/>
            </StackPanel>
          </Border>

        </Grid>
      </Border>

    </Grid>

  </DockPanel>

</UserControl>
