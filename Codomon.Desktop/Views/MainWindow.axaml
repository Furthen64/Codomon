<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Codomon.Desktop.Views.MainWindow"
        Title="codomon"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <DockPanel LastChildFill="True">

    <!-- Top Toolbar — slim nav bar -->
    <Border DockPanel.Dock="Top" Background="#1E2A3A" BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
      <Grid Height="44">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: codomon wordmark + workspace dropdown -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Text="◈" FontSize="18" Foreground="#4A90D9" VerticalAlignment="Center"/>
          <TextBlock Text="codomon" FontSize="13" FontWeight="Bold" Foreground="#8AB4D4"
                     VerticalAlignment="Center" Margin="0,0,6,0"/>
          <!-- Workspace name dropdown -->
          <Button x:Name="WorkspaceDropBtn" Padding="8,3" VerticalAlignment="Center">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="New Workspace"     Click="OnNewWorkspaceClick"/>
                <MenuItem Header="Open Workspace…"   Click="OnOpenWorkspaceClick"/>
                <MenuItem Header="Save"              Click="OnSaveWorkspaceClick"/>
                <MenuItem Header="Save As…"          Click="OnSaveAsWorkspaceClick"/>
                <MenuItem Header="Load Autosave…"    Click="OnLoadAutosaveClick"/>
                <Separator/>
                <MenuItem Header="New Profile"       Click="OnNewProfileClick"/>
                <MenuItem Header="Rename Profile"    Click="OnRenameProfileClick"/>
                <MenuItem Header="Duplicate Profile" Click="OnDuplicateProfileClick"/>
                <MenuItem Header="Delete Profile"    Click="OnDeleteProfileClick"/>
              </MenuFlyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock x:Name="WorkspaceNameText" Text="No Workspace" VerticalAlignment="Center"/>
              <TextBlock Text="▾" VerticalAlignment="Center" Opacity="0.6" FontSize="10"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Center: five navigation tabs -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    Spacing="2" VerticalAlignment="Center">
          <Button x:Name="NavDesignBtn"  Content="Design"  Tag="Design"  Click="OnNavTabClick" Padding="14,5"/>
          <Button x:Name="NavScanBtn"    Content="Scan"    Tag="Scan"    Click="OnNavTabClick" Padding="14,5"/>
          <Button x:Name="NavMonitorBtn" Content="Monitor" Tag="Monitor" Click="OnNavTabClick" Padding="14,5"/>
          <Button x:Name="NavGraphBtn"   Content="Graph"   Tag="Graph"   Click="OnNavTabClick" Padding="14,5"/>
          <Button x:Name="NavDocsBtn"    Content="Docs"    Tag="Docs"    Click="OnNavTabClick" Padding="14,5"/>
        </StackPanel>

        <!-- Right: running indicator + stop button + settings gear -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center" Margin="0,0,10,0">
          <Border x:Name="RunningIndicatorBorder" Background="#152A15" CornerRadius="10"
                  Padding="8,3" IsVisible="False">
            <TextBlock Text="● Running" Foreground="#44CC44" FontSize="11" VerticalAlignment="Center"/>
          </Border>
          <Button x:Name="TopBarStopBtn" Content="■ Stop" Click="OnStopWatchClick"
                  IsVisible="False" Padding="8,3"/>
          <Button x:Name="TopBarSettingsBtn" Content="⚙" Click="OnSettingsClick"
                  Padding="8,5" FontSize="14" ToolTip.Tip="Settings"/>
        </StackPanel>

        <!-- Hidden ProfileComboBox retained for code-behind compatibility -->
        <ComboBox x:Name="ProfileComboBox" IsVisible="False" Width="0" Grid.Column="0"
                  SelectionChanged="OnProfileComboBoxSelectionChanged"/>

      </Grid>
    </Border>

    <!-- Status Bar -->
    <Border DockPanel.Dock="Bottom" Background="#111820" Padding="8,3" BorderThickness="0,1,0,0" BorderBrush="#2A3F5A">
      <TextBlock x:Name="StatusText" Text="Ready" Foreground="#88AABB" FontSize="11"/>
    </Border>

    <!-- Main Content Area + resizable Bottom Panel -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="5" MinHeight="5"/>
        <RowDefinition Height="200" MinHeight="80"/>
      </Grid.RowDefinitions>

      <!-- GridSplitter between main content and bottom panel -->
      <GridSplitter Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Background="#2A3F5A"
                    ResizeDirection="Rows"/>

      <!-- Bottom Panel (Logs / Timeline) -->
      <Border Grid.Row="2" Background="#141C28" BorderThickness="0,1,0,0" BorderBrush="#2A3F5A">
        <TabControl>
          <TabItem Header="Log Stream">
            <DockPanel>

              <!-- Replay toolbar -->
              <Border DockPanel.Dock="Top" Background="#1A2435" Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button x:Name="ImportLogButton"  Content="📂 Import"  Padding="8,3" Click="OnImportLogClick"/>
                  <Button x:Name="ReplayPlayButton"  Content="▶ Play"    Padding="8,3" Click="OnReplayPlayClick"  IsEnabled="False"/>
                  <Button x:Name="ReplayPauseButton" Content="⏸ Pause"   Padding="8,3" Click="OnReplayPauseClick" IsEnabled="False"/>
                  <Button x:Name="ReplayStopButton"  Content="⏹ Stop"    Padding="8,3" Click="OnReplayStopClick"  IsEnabled="False"/>
                  <TextBlock Text="Speed:" VerticalAlignment="Center" Foreground="#778899" Margin="8,0,2,0"/>
                  <ComboBox x:Name="ReplaySpeedComboBox" Width="70" Padding="4,2"
                            SelectionChanged="OnReplaySpeedChanged"/>
                  <TextBlock x:Name="ReplayStatusText" VerticalAlignment="Center"
                             Foreground="#556677" FontSize="11" Margin="12,0,0,0"
                             Text="No log loaded"/>

                  <!-- Separator between replay and live-watch controls -->
                  <Border Width="1" Margin="6,2" Background="#2A3F5A"/>

                  <Button x:Name="WatchLogButton"  Content="📡 Watch…"  Padding="8,3" Click="OnWatchLogClick"  IsEnabled="False"/>
                  <Button x:Name="StopWatchButton" Content="⏹ Stop"     Padding="8,3" Click="OnStopWatchClick" IsEnabled="False"/>
                  <TextBlock x:Name="WatchStatusText" VerticalAlignment="Center"
                             Foreground="#556677" FontSize="11" Margin="8,0,0,0"
                             Text="Not watching"/>
                </StackPanel>
              </Border>

              <!-- Log entry list -->
              <ListBox x:Name="ImportedLogsListBox" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

            </DockPanel>
          </TabItem>
          <TabItem Header="Timeline">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ContentControl x:Name="TimelineHost" HorizontalContentAlignment="Stretch"/>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Connections">
            <DockPanel>
              <!-- Toolbar -->
              <Border DockPanel.Dock="Top" Background="#1A2435" Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Workspace connections — Roslyn-origin connections are marked read-only."
                             VerticalAlignment="Center" Foreground="#556677" FontSize="11"/>
                  <Button x:Name="PromoteConnectionButton" Content="⬆ Promote to Manual"
                          Click="OnPromoteConnectionClick"
                          Padding="8,3" IsEnabled="False"/>
                </StackPanel>
              </Border>
              <!-- Connections list -->
              <ListBox x:Name="ConnectionsListBox"
                       Background="Transparent"
                       SelectionChanged="OnConnectionsListSelectionChanged"/>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Border>

      <!-- Main Content rows (row 0) -->
      <Grid Grid.Row="0">

      <!-- ── Design tab placeholder ─── -->
      <Grid x:Name="DesignPanel" IsVisible="False" Background="#0F141E">
        <TextBlock Text="Design" FontSize="24" Foreground="#4A6A8A"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>

      <!-- ── Scan tab panel (devtools) ─── -->
      <Grid x:Name="ScanPanel" IsVisible="False" Background="#0F141E">
        <DockPanel Margin="40,32">
          <TextBlock DockPanel.Dock="Top" Text="Scan" FontSize="18" FontWeight="Bold"
                     Foreground="#AABBCC" Margin="0,0,0,20"/>
          <StackPanel Spacing="8" DockPanel.Dock="Top">
            <Button Content="Run Scan"           Click="OnScanClick"       Padding="14,6" HorizontalAlignment="Left"/>
            <Button Content="LLM Summaries"      Click="OnSummariesClick"  Padding="14,6" HorizontalAlignment="Left"/>
            <Button Content="Architecture"       Click="OnHypothesisClick" Padding="14,6" HorizontalAlignment="Left"/>
            <Button Content="Replay Logs"        Click="OnImportLogClick" Padding="14,6" HorizontalAlignment="Left"/>
            <Button Content="Dev Console"        Click="OnDevConsoleClick" Padding="14,6" HorizontalAlignment="Left"/>
          </StackPanel>
        </DockPanel>
      </Grid>

      <!-- ── Docs tab placeholder ─── -->
      <Grid x:Name="DocsPanel" IsVisible="False" Background="#0F141E">
        <TextBlock Text="Docs" FontSize="24" Foreground="#4A6A8A"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>

      <!-- ── 3-column workspace layout ─── -->
      <Grid x:Name="WorkspaceGrid" IsVisible="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: TreeView -->
        <Border Grid.Column="0" Background="#141C28" BorderThickness="0,0,1,0" BorderBrush="#2A3F5A">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="8,6" Background="#1A2435">
              <TextBlock Text="Architecture" FontWeight="Bold" Foreground="#AABBCC"/>
            </Border>
            <TreeView x:Name="ArchTreeView" Background="Transparent" Margin="4"/>
          </DockPanel>
        </Border>

        <!-- Center Panel: Graph / System Map tabs -->
        <Border Grid.Column="1" Background="#0F141E" ClipToBounds="True">
          <TabControl x:Name="CenterTabControl"
                      SelectionChanged="OnCenterTabSelectionChanged"
                      Background="Transparent"
                      BorderThickness="0,0,0,1"
                      BorderBrush="#2A3F5A">
            <TabItem Header="System Map">
              <ContentControl x:Name="SystemMapHost"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"/>
            </TabItem>
            <TabItem Header="Graph">
              <ContentControl x:Name="CanvasHost"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"/>
            </TabItem>
          </TabControl>
        </Border>

        <!-- Right Panel: Properties -->
        <Border Grid.Column="2" Background="#141C28" BorderThickness="1,0,0,0" BorderBrush="#2A3F5A">
          <DockPanel>
            <Border DockPanel.Dock="Top" Padding="8,6" Background="#1A2435">
              <TextBlock Text="Properties" FontWeight="Bold" Foreground="#AABBCC"/>
            </Border>
            <StackPanel Margin="10" Spacing="8">
              <TextBlock Text="Selected Item" Foreground="#778899" FontSize="11"/>
              <StackPanel Spacing="4">
                <TextBlock Text="Name:" Foreground="#AABBCC" FontWeight="SemiBold"/>
                <TextBlock x:Name="PropNameText" Text="None" Foreground="White" Margin="0,0,0,8"/>
                <TextBlock Text="Type:" Foreground="#AABBCC" FontWeight="SemiBold"/>
                <TextBlock x:Name="PropTypeText" Text="-" Foreground="White" Margin="0,0,0,8"/>
              </StackPanel>

              <!-- Mapping rules section — visible only when an item is selected -->
              <StackPanel x:Name="PropRulesPanel" IsVisible="False" Spacing="4">
                <Border Height="1" Background="#2A3F5A" Margin="0,4,0,4"/>
                <TextBlock Text="Mapping Rules" Foreground="#AABBCC" FontWeight="SemiBold"/>
                <TextBlock x:Name="PropRulesCountText" Foreground="#778899" FontSize="11"/>
                <Button x:Name="EditRulesButton" Content="📏 Edit Rules…"
                        Padding="8,4" Click="OnEditRulesClick"/>
              </StackPanel>

              <!-- Last match info — visible during/after log replay -->
              <StackPanel x:Name="PropMatchPanel" IsVisible="False" Spacing="4">
                <Border Height="1" Background="#2A3F5A" Margin="0,4,0,4"/>
                <TextBlock Text="Last Match" Foreground="#AABBCC" FontWeight="SemiBold"/>
                <TextBlock x:Name="PropMatchText" Foreground="#88CCAA" FontSize="11"
                           TextWrapping="Wrap"/>
              </StackPanel>

              <!-- Graph auto-align controls -->
              <StackPanel x:Name="PropAutoAlignPanel" IsVisible="False" Spacing="6">
                <Border Height="1" Background="#2A3F5A" Margin="0,4,0,4"/>
                <TextBlock Text="Graph Auto Align" Foreground="#AABBCC" FontWeight="SemiBold"/>

                <TextBlock Text="Preset" Foreground="#778899" FontSize="11"/>
                <ComboBox x:Name="PropAutoAlignPresetComboBox"
                          SelectionChanged="OnPropAutoAlignPresetChanged"
                          HorizontalAlignment="Left" MinWidth="170">
                  <ComboBoxItem Content="Balanced" Tag="balanced"/>
                  <ComboBoxItem Content="Dense Graph" Tag="dense"/>
                  <ComboBoxItem Content="Max Separation" Tag="separated"/>
                </ComboBox>

                <TextBlock Text="Barycentric sweeps" Foreground="#778899" FontSize="11"/>
                <NumericUpDown x:Name="PropAutoAlignSweepsBox"
                               Minimum="1" Maximum="20" Increment="1" FormatString="0"
                               HorizontalAlignment="Left" MinWidth="120"/>

                <CheckBox x:Name="PropAutoAlignTwoPassCheck"
                          Content="Second refinement pass"
                          Foreground="#AABBCC"/>

                <TextBlock Text="Column gap" Foreground="#778899" FontSize="11"/>
                <NumericUpDown x:Name="PropAutoAlignColumnGapBox"
                               Minimum="100" Maximum="700" Increment="20" FormatString="0"
                               HorizontalAlignment="Left" MinWidth="120"/>

                <TextBlock Text="Row gap" Foreground="#778899" FontSize="11"/>
                <NumericUpDown x:Name="PropAutoAlignRowGapBox"
                               Minimum="40" Maximum="280" Increment="8" FormatString="0"
                               HorizontalAlignment="Left" MinWidth="120"/>

                <TextBlock Text="Component gap" Foreground="#778899" FontSize="11"/>
                <NumericUpDown x:Name="PropAutoAlignComponentGapBox"
                               Minimum="20" Maximum="500" Increment="20" FormatString="0"
                               HorizontalAlignment="Left" MinWidth="120"/>

                <Button x:Name="PropAutoAlignApplyButton"
                        Content="Apply Auto Align"
                        Padding="8,4"
                        Click="OnPropAutoAlignApplyClick"/>
              </StackPanel>

            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ── Welcome / Recent Workspaces overlay ─── -->
      <Grid x:Name="WelcomeOverlay" Background="#0F141E" IsVisible="True">
        <DockPanel Margin="60,40">

          <!-- Header row -->
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,28">
            <TextBlock Text="codomon" FontSize="32" FontWeight="Bold" Foreground="#AABBCC"/>
            <TextBlock Text="Recent Workspaces" FontSize="20" Foreground="#778899"/>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
              <Button Content="✚  New Workspace"  Click="OnNewWorkspaceClick"  Padding="14,6" FontSize="13"/>
              <Button Content="📂  Open Workspace" Click="OnOpenWorkspaceClick" Padding="14,6" FontSize="13"/>
            </StackPanel>
          </StackPanel>

          <!-- Separator -->
          <Border DockPanel.Dock="Top" Height="1" Background="#2A3F5A" Margin="0,0,0,16"/>

          <!-- Recent workspaces list -->
          <ScrollViewer>
            <ListBox x:Name="RecentWorkspacesListBox"
                     Background="Transparent"
                     SelectionChanged="OnRecentWorkspaceSelected">
              <!-- Items populated from code-behind -->
            </ListBox>
          </ScrollViewer>

        </DockPanel>
      </Grid>

    </Grid><!-- end main content row 0 -->

  </Grid><!-- end resizable outer Grid -->

  </DockPanel>
</Window>

