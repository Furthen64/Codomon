<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Codomon.Desktop.Views.MainWindow"
        Title="codomon"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <DockPanel LastChildFill="True">

    <!-- Classic Menu Bar -->
    <Menu DockPanel.Dock="Top" Background="#161E2C" Padding="2,0">

      <!-- File menu -->
      <MenuItem Header="_File" Padding="8,4">
        <MenuItem Header="New Workspace"       Click="OnNewWorkspaceClick"    HotKey="Ctrl+N"
                  ToolTip.Tip="Create a new workspace (Ctrl+N)"/>
        <MenuItem Header="Open Workspace…"     Click="OnOpenWorkspaceClick"   HotKey="Ctrl+O"
                  ToolTip.Tip="Open an existing workspace folder (Ctrl+O)"/>
        <Separator/>
        <MenuItem Header="Save"                Click="OnSaveWorkspaceClick"   HotKey="Ctrl+S"
                  ToolTip.Tip="Save the current workspace (Ctrl+S)"/>
        <MenuItem Header="Save As…"            Click="OnSaveAsWorkspaceClick" HotKey="Ctrl+Shift+S"
                  ToolTip.Tip="Save the workspace to a new folder (Ctrl+Shift+S)"/>
        <MenuItem Header="Load Autosave…"      Click="OnLoadAutosaveClick"
                  ToolTip.Tip="Restore a previously auto-saved workspace snapshot"/>
        <Separator/>
        <MenuItem Header="New Profile"         Click="OnNewProfileClick"
                  ToolTip.Tip="Create a new layout profile for the current workspace"/>
        <MenuItem Header="Rename Profile"      Click="OnRenameProfileClick"
                  ToolTip.Tip="Rename the active layout profile"/>
        <MenuItem Header="Duplicate Profile"   Click="OnDuplicateProfileClick"
                  ToolTip.Tip="Duplicate the active layout profile"/>
        <MenuItem Header="Delete Profile"      Click="OnDeleteProfileClick"
                  ToolTip.Tip="Delete the active layout profile"/>
        <Separator/>
        <MenuItem Header="E_xit"               Click="OnExitClick"/>
      </MenuItem>

      <!-- Tools menu -->
      <MenuItem Header="_Tools" Padding="8,4">
        <MenuItem Header="Roslyn Scan…"              Click="OnScanClick"
                  ToolTip.Tip="Run a Roslyn static analysis scan on the source project"/>
        <MenuItem Header="LLM Summaries…"            Click="OnSummariesClick"
                  ToolTip.Tip="Generate LLM-powered summaries for scanned source files"/>
        <MenuItem Header="Architecture Hypothesis…"  Click="OnHypothesisClick"
                  ToolTip.Tip="Generate and review architecture hypotheses using LLM analysis"/>
        <Separator/>
        <MenuItem Header="Locator…"                  Click="OnLocatorClick"   HotKey="Ctrl+Shift+L"
                  ToolTip.Tip="Open the Locator to search workspace entities (Ctrl+Shift+L)"/>
        <Separator/>
        <MenuItem Header="Dev Console"               Click="OnDevConsoleClick" HotKey="F12"
                  ToolTip.Tip="Open the developer diagnostics console (F12)"/>
        <Separator/>
        <MenuItem Header="_Preferences…"             Click="OnSettingsClick"   HotKey="Ctrl+OemComma"
                  ToolTip.Tip="Edit user preferences (Ctrl+,)"/>
      </MenuItem>

      <!-- Help menu -->
      <MenuItem Header="_Help" Padding="8,4">
        <MenuItem Header="About codomon"             Click="OnAboutClick"/>
      </MenuItem>

    </Menu>

    <!-- Top Toolbar — slim nav bar -->
    <Border DockPanel.Dock="Top" Background="#1E2A3A" BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
      <Grid Height="44">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: codomon wordmark + workspace dropdown -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center" Margin="10,0,0,0">
          <Button Click="OnLogoClick" Padding="0" Background="Transparent"
                  BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                  ToolTip.Tip="Go to System Overview">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="◈" FontSize="18" Foreground="#4A90D9" VerticalAlignment="Center"/>
              <TextBlock Text="codomon" FontSize="13" FontWeight="Bold" Foreground="#8AB4D4"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <!-- Workspace name dropdown -->
          <Button x:Name="WorkspaceDropBtn" Padding="8,3" VerticalAlignment="Center">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="New Workspace"     Click="OnNewWorkspaceClick"/>
                <MenuItem Header="Open Workspace…"   Click="OnOpenWorkspaceClick"/>
                <MenuItem Header="Save"              Click="OnSaveWorkspaceClick"/>
                <MenuItem Header="Save As…"          Click="OnSaveAsWorkspaceClick"/>
                <MenuItem Header="Load Autosave…"    Click="OnLoadAutosaveClick"/>
                <Separator/>
                <MenuItem Header="New Profile"       Click="OnNewProfileClick"/>
                <MenuItem Header="Rename Profile"    Click="OnRenameProfileClick"/>
                <MenuItem Header="Duplicate Profile" Click="OnDuplicateProfileClick"/>
                <MenuItem Header="Delete Profile"    Click="OnDeleteProfileClick"/>
              </MenuFlyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock x:Name="WorkspaceNameText" Text="No Workspace" VerticalAlignment="Center"/>
              <TextBlock Text="▾" VerticalAlignment="Center" Opacity="0.6" FontSize="10"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Center: six navigation tabs -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    Spacing="2" VerticalAlignment="Center">
          <Button x:Name="NavDesignBtn"  Content="Design"  Tag="Design"  Click="OnNavTabClick" Padding="14,5"
                  ToolTip.Tip="Design tab — architecture component editor"/>
          <Button x:Name="NavScanBtn"    Content="Analyze" Tag="Scan"    Click="OnNavTabClick" Padding="14,5"
                  ToolTip.Tip="Analyze tab — run scan, summaries and architecture synthesis"/>
          <Button x:Name="NavMonitorBtn" Content="Monitor" Tag="Monitor" Click="OnNavTabClick" Padding="14,5"
                  ToolTip.Tip="Monitor tab — system map and live log stream"/>
          <Button x:Name="NavGraphBtn"   Content="Graph"   Tag="Graph"   Click="OnNavTabClick" Padding="14,5"
                  ToolTip.Tip="Graph tab — AST relationship graph"/>
          <Button x:Name="NavCodeBtn"    Content="Code"    Tag="Code"    Click="OnNavTabClick" Padding="14,5"
                  ToolTip.Tip="Code tab — browse the repository tree and preview files"/>
          <Button x:Name="NavDocsBtn"    Content="Docs"    Tag="Docs"    Click="OnNavTabClick" Padding="14,5"
                  ToolTip.Tip="Docs tab — workspace documentation browser"/>
        </StackPanel>

        <!-- Right: running indicator + stop button + settings gear -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center" Margin="0,0,10,0">
          <Border x:Name="RunningIndicatorBorder" Background="#152A15" CornerRadius="10"
                  Padding="8,3" IsVisible="False">
            <TextBlock Text="● Running" Foreground="#44CC44" FontSize="11" VerticalAlignment="Center"/>
          </Border>
          <Button x:Name="TopBarStopBtn" Content="■ Stop" Click="OnStopWatchClick"
                  IsVisible="False" Padding="8,3"/>
          <Button x:Name="TopBarSettingsBtn" Content="⚙" Click="OnSettingsClick"
                  Padding="8,5" FontSize="14" ToolTip.Tip="Settings"/>
        </StackPanel>

        <!-- Hidden ProfileComboBox retained for code-behind compatibility -->
        <ComboBox x:Name="ProfileComboBox" IsVisible="False" Width="0" Grid.Column="0"
                  SelectionChanged="OnProfileComboBoxSelectionChanged"/>

      </Grid>
    </Border>

    <!-- Status Bar -->
    <Border DockPanel.Dock="Bottom" Background="#111820" Padding="0" BorderThickness="0,1,0,0" BorderBrush="#2A3F5A">
      <DockPanel Height="22">

        <!-- Right: metric pills -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="0"
                    Margin="0,0,10,0" VerticalAlignment="Center">
          <TextBlock x:Name="StatusBarFilesText"     Text="" FontSize="10" Foreground="#556677"/>
          <TextBlock x:Name="StatusBarSep1"          Text="" FontSize="10" Foreground="#3A4A5A"/>
          <TextBlock x:Name="StatusBarClassesText"   Text="" FontSize="10" Foreground="#556677"/>
          <TextBlock x:Name="StatusBarSep2"          Text="" FontSize="10" Foreground="#3A4A5A"/>
          <TextBlock x:Name="StatusBarMethodsText"   Text="" FontSize="10" Foreground="#556677"/>
          <TextBlock x:Name="StatusBarSep3"          Text="" FontSize="10" Foreground="#3A4A5A"/>
          <TextBlock x:Name="StatusBarLogPtsText"    Text="" FontSize="10" Foreground="#556677"/>
          <TextBlock x:Name="StatusBarSep4"          Text="" FontSize="10" Foreground="#3A4A5A" IsVisible="False"/>
          <TextBlock x:Name="StatusBarRuntimeText"   Text="" FontSize="10" Foreground="#556677" IsVisible="False"/>
          <TextBlock x:Name="StatusBarSep5"          Text="" FontSize="10" Foreground="#3A4A5A" IsVisible="False"/>
          <TextBlock x:Name="StatusBarEventsText"    Text="" FontSize="10" Foreground="#556677" IsVisible="False"/>
        </StackPanel>

        <!-- Left: scan-status dot + label + separator + general status message -->
        <StackPanel Orientation="Horizontal" Spacing="5" Margin="8,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="StatusScanDot"   Text="●" FontSize="10" Foreground="#3A4A5A" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusScanLabel" Text="Idle" FontSize="10" Foreground="#556677" VerticalAlignment="Center"/>
          <TextBlock Text="|" FontSize="10" Foreground="#2A3A4A" VerticalAlignment="Center" Margin="3,0"/>
          <TextBlock x:Name="StatusText" Text="Ready" Foreground="#88AABB" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>

      </DockPanel>
    </Border>

    <!-- Main Content Area + resizable Bottom Panel -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="5" MinHeight="5"/>
        <RowDefinition Height="200" MinHeight="80"/>
      </Grid.RowDefinitions>

      <!-- GridSplitter between main content and bottom panel -->
      <GridSplitter Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Background="#2A3F5A"
                    ResizeDirection="Rows"/>

      <!-- Bottom Panel (Log Stream | Timeline) -->
      <Border Grid.Row="2" Background="#141C28" BorderThickness="0,1,0,0" BorderBrush="#2A3F5A">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.65*" MinWidth="180"/>
            <ColumnDefinition Width="5" MinWidth="5"/>
            <ColumnDefinition Width="0.35*" MinWidth="120"/>
          </Grid.ColumnDefinitions>

          <!-- Horizontal splitter between log stream and timeline -->
          <GridSplitter Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Background="#2A3F5A"
                        ResizeDirection="Columns"/>

          <!-- ── Left: Log Stream (replay + live monitoring) ── -->
          <DockPanel Grid.Column="0">

            <!-- Header: title + streaming indicator + replay + live controls -->
            <Border DockPanel.Dock="Top" Background="#1A2435" Padding="6,4"
                    BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title + streaming indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="Log Stream" FontWeight="SemiBold"
                             Foreground="#AABBCC" FontSize="12" VerticalAlignment="Center"/>
                  <Border x:Name="LogStreamIndicatorBorder" CornerRadius="8" Padding="6,2"
                          Background="#0F1E0F">
                    <TextBlock x:Name="LogStreamIndicatorText" Text="○ Idle"
                               Foreground="#556677" FontSize="10" VerticalAlignment="Center"/>
                  </Border>
                </StackPanel>

                <!-- Replay controls | Live monitoring controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                  <!-- Replay: import a log file, then play / pause / stop -->
                  <Button x:Name="ImportLogButton"   Content="📂 Import" Padding="6,2" FontSize="11"
                          Click="OnImportLogClick"   IsEnabled="False"
                          ToolTip.Tip="Import a log file for replay"/>
                  <Button x:Name="ReplayPlayButton"  Content="▶ Play"    Padding="6,2" FontSize="11"
                          Click="OnReplayPlayClick"  IsEnabled="False"
                          ToolTip.Tip="Play the imported log replay"/>
                  <ComboBox x:Name="ReplaySpeedComboBox" SelectionChanged="OnReplaySpeedChanged"
                            ToolTip.Tip="Replay speed multiplier"
                            MinWidth="56" FontSize="11" Padding="4,2" VerticalAlignment="Center"/>
                  <Button x:Name="ReplayPauseButton" Content="⏸"         Padding="6,2" FontSize="11"
                          Click="OnReplayPauseClick" IsEnabled="False"
                          ToolTip.Tip="Pause / resume the log replay"/>
                  <Button x:Name="ReplayStopButton"  Content="■"         Padding="6,2" FontSize="11"
                          Click="OnReplayStopClick"  IsEnabled="False"
                          ToolTip.Tip="Stop the log replay and reset position"/>

                  <!-- Visual separator between replay and live sections -->
                  <Border Width="1" Background="#2A3F5A" Margin="4,2"/>

                  <!-- Live monitoring: watch a live log file, pause auto-scroll, stop -->
                  <Button x:Name="WatchLogButton"     Content="📡 Watch"   Padding="6,2" FontSize="11"
                          Click="OnWatchLogClick"    IsEnabled="False"
                          ToolTip.Tip="Start live monitoring of a log file"/>
                  <Button x:Name="LogStreamPauseBtn" Content="⏸ Pause"   Padding="6,2" FontSize="11"
                          Click="OnLogStreamPauseClick" IsEnabled="False"
                          ToolTip.Tip="Pause / resume live stream auto-scroll"/>
                  <Button x:Name="StopWatchButton"   Content="■ Stop"     Padding="6,2" FontSize="11"
                          Click="OnStopWatchClick"   IsEnabled="False"
                          ToolTip.Tip="Stop live log monitoring"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Column headers -->
            <Border DockPanel.Dock="Top" Background="#141C28" Padding="4,3"
                    BorderThickness="0,0,0,1" BorderBrush="#1E2A3A">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="80"/>
                  <ColumnDefinition Width="52"/>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TIME"    FontSize="9" FontWeight="Bold"
                           Foreground="#4A6A8A" LetterSpacing="1" Margin="4,0"/>
                <TextBlock Grid.Column="1" Text="LEVEL"   FontSize="9" FontWeight="Bold"
                           Foreground="#4A6A8A" LetterSpacing="1" Margin="4,0"/>
                <TextBlock Grid.Column="2" Text="SOURCE"  FontSize="9" FontWeight="Bold"
                           Foreground="#4A6A8A" LetterSpacing="1" Margin="4,0"/>
                <TextBlock Grid.Column="3" Text="MESSAGE" FontSize="9" FontWeight="Bold"
                           Foreground="#4A6A8A" LetterSpacing="1" Margin="4,0"/>
              </Grid>
            </Border>

            <!-- Log entry list -->
            <ListBox x:Name="ImportedLogsListBox" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

          </DockPanel>

          <!-- ── Right: Timeline / Sessions / Connections tabs ── -->
          <TabControl Grid.Column="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="Timeline">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="TimelineHost" HorizontalContentAlignment="Stretch"/>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Sessions">
              <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1A2435" Padding="6,4"
                        BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
                  <TextBlock Text="Monitoring sessions" FontSize="11" Foreground="#556677"/>
                </Border>
                <ListBox x:Name="SessionsListBox" Background="Transparent"/>
              </DockPanel>
            </TabItem>
            <TabItem Header="Connections">
              <DockPanel>
                <!-- Toolbar -->
                <Border DockPanel.Dock="Top" Background="#1A2435" Padding="6,4"
                        BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Workspace connections — Roslyn-origin connections are marked read-only."
                               VerticalAlignment="Center" Foreground="#556677" FontSize="11"/>
                    <Button x:Name="PromoteConnectionButton" Content="⬆ Promote to Manual"
                            Click="OnPromoteConnectionClick"
                            Padding="8,3" IsEnabled="False"/>
                  </StackPanel>
                </Border>
                <!-- Connections list -->
                <ListBox x:Name="ConnectionsListBox"
                         Background="Transparent"
                         SelectionChanged="OnConnectionsListSelectionChanged"/>
              </DockPanel>
            </TabItem>
          </TabControl>

        </Grid>
      </Border>

      <!-- Main Content rows (row 0) -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>  <!-- sidebar -->
          <ColumnDefinition Width="*"/>    <!-- content area -->
        </Grid.ColumnDefinitions>

        <!-- ── Left Sidebar — always visible when a workspace is loaded ── -->
        <Border x:Name="SidebarPanel" Grid.Column="0" IsVisible="False"
                Background="#141C28" BorderThickness="0,0,1,0" BorderBrush="#2A3F5A">
          <DockPanel>

            <!-- User profile strip — docked to the bottom -->
            <Border DockPanel.Dock="Bottom" Background="#111820" Padding="10,7"
                    BorderThickness="0,1,0,0" BorderBrush="#2A3F5A">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                        Background="#2A4A6A" VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock x:Name="ProfileInitialText" Text="D"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             FontSize="11" FontWeight="Bold" Foreground="White"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                  <TextBlock x:Name="ProfileDisplayNameText" Text="developer"
                             FontSize="12" FontWeight="SemiBold" Foreground="#AABBCC"/>
                  <TextBlock Text="Local Workspace" FontSize="10" Foreground="#556677"/>
                </StackPanel>
                <Button Grid.Column="2" Content="⚙" Click="OnSettingsClick"
                        Padding="5,3" FontSize="13" ToolTip.Tip="User Settings"
                        VerticalAlignment="Center" Background="Transparent"/>
              </Grid>
            </Border>

            <!-- Scrollable sidebar sections -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>

                <!-- WORKSPACE section -->
                <StackPanel Margin="8,8,8,4" Spacing="2">
                  <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold"
                             Foreground="#556677" Margin="2,0,0,4"/>
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                    <TextBlock Text="📁" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel Spacing="1" MinWidth="0">
                      <TextBlock x:Name="SidebarWorkspaceNameText" Text="—"
                                 FontSize="12" FontWeight="SemiBold" Foreground="#AABBCC"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="SidebarSourcePathText" Text=""
                                 FontSize="10" Foreground="#556677"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>

                <Border Height="1" Background="#1E2A3A" Margin="8,4"/>

                <!-- ANALYSIS section -->
                <StackPanel Margin="8,4,8,2" Spacing="0">
                  <TextBlock Text="ANALYSIS" FontSize="10" FontWeight="Bold"
                             Foreground="#556677" Margin="2,0,0,6"/>

                  <!-- Scan Summary -->
                  <Button x:Name="AnalysisScanSummaryBtn" Click="OnAnalysisScanSummaryClick"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Background="Transparent" Padding="4,4" CornerRadius="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="📋" FontSize="11" VerticalAlignment="Center"/>
                      <TextBlock Text="Scan Summary" FontSize="11" Foreground="#AABBCC" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>

                  <!-- Source Files -->
                  <Button x:Name="AnalysisSourceFilesBtn" Click="OnAnalysisSourceFilesClick"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Background="Transparent" Padding="4,4" CornerRadius="3">
                    <Grid HorizontalAlignment="Stretch">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📄" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Source Files" FontSize="11" Foreground="#AABBCC" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock x:Name="AnalysisSourceFilesCountText" Grid.Column="1"
                                 Text="" FontSize="10" Foreground="#556677" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>

                  <!-- Markdown Docs -->
                  <Button x:Name="AnalysisMarkdownDocsBtn" Click="OnAnalysisMarkdownDocsClick"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Background="Transparent" Padding="4,4" CornerRadius="3">
                    <Grid HorizontalAlignment="Stretch">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📝" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Markdown Docs" FontSize="11" Foreground="#AABBCC" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock x:Name="AnalysisMarkdownDocsCountText" Grid.Column="1"
                                 Text="" FontSize="10" Foreground="#556677" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>

                  <!-- AST Graph -->
                  <Button x:Name="AnalysisAstGraphBtn" Click="OnAnalysisAstGraphClick"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Background="Transparent" Padding="4,4" CornerRadius="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="🔷" FontSize="11" VerticalAlignment="Center"/>
                      <TextBlock Text="AST Graph" FontSize="11" Foreground="#AABBCC" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>

                  <!-- Log Points -->
                  <Button x:Name="AnalysisLogPointsBtn" Click="OnAnalysisLogPointsClick"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Background="Transparent" Padding="4,4" CornerRadius="3">
                    <Grid HorizontalAlignment="Stretch">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📍" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Log Points" FontSize="11" Foreground="#AABBCC" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock x:Name="AnalysisLogPointsCountText" Grid.Column="1"
                                 Text="" FontSize="10" Foreground="#556677" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                </StackPanel>

                <Border Height="1" Background="#1E2A3A" Margin="8,4"/>

                <!-- ARCHITECTURE MAP header + tree -->
                <Grid Margin="8,6,8,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="ARCHITECTURE MAP" FontSize="10" FontWeight="Bold"
                             Foreground="#556677" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="+" Click="OnAddArchComponentClick"
                          Padding="5,2" FontSize="14" FontWeight="Bold"
                          ToolTip.Tip="Add new architecture component"
                          VerticalAlignment="Center" Background="Transparent" Foreground="#4A90D9"/>
                </Grid>
                <TreeView x:Name="ArchTreeView" Background="Transparent" Margin="2,2,2,4"/>

              </StackPanel>
            </ScrollViewer>

          </DockPanel>
        </Border>

        <!-- ── Content area (all tab panels sit here) ── -->
        <Grid Grid.Column="1">

        <!-- ── Design tab placeholder ─── -->
        <Grid x:Name="DesignPanel" IsVisible="False" Background="#0F141E">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420">
            <TextBlock Text="✏" FontSize="40" HorizontalAlignment="Center" Foreground="#2A3F5A"/>
            <TextBlock Text="Design" FontSize="22" FontWeight="Bold" Foreground="#4A6A8A"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="The visual design editor will appear here in a future release. Use the Architecture Hypothesis tool (Tools menu) to scaffold your architecture map from LLM analysis."
                       FontSize="12" Foreground="#556677" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
          </StackPanel>
        </Grid>

        <!-- ── Analyze tab panel (devtools) ─── -->
        <Grid x:Name="ScanPanel" IsVisible="False" Background="#0F141E">
          <DockPanel Margin="40,32">
            <TextBlock DockPanel.Dock="Top" Text="Analyze" FontSize="18" FontWeight="Bold"
                      Foreground="#AABBCC" Margin="0,0,0,6"/>
            <TextBlock DockPanel.Dock="Top" Text="Run analysis in order: Scan → LLM Summaries → Architecture. Replay Logs and Dev Console are always available."
                      FontSize="12" Foreground="#778899" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <StackPanel Spacing="10" DockPanel.Dock="Top">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <Button x:Name="AnalyzeRunScanBtn" Grid.Column="0" Grid.RowSpan="2"
                        Content="Run Scan" Click="OnScanClick" Padding="14,6" HorizontalAlignment="Left" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Grid.Row="0" Text="Available always" FontSize="11" Foreground="#AABBCC" Margin="0,0,0,2"/>
                <TextBlock x:Name="AnalyzeRunScanStatusText" Grid.Column="1" Grid.Row="1"
                          Text="" FontSize="10" Foreground="#556677"/>
              </Grid>

              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <Button x:Name="AnalyzeLlmSummariesBtn" Grid.Column="0" Grid.RowSpan="2"
                        Content="LLM Summaries" Click="OnSummariesClick" Padding="14,6" HorizontalAlignment="Left" Margin="0,0,12,0"/>
                <TextBlock x:Name="AnalyzeLlmSummariesAvailabilityText" Grid.Column="1" Grid.Row="0"
                          Text="" FontSize="11" Foreground="#AABBCC" Margin="0,0,0,2"/>
                <TextBlock x:Name="AnalyzeLlmSummariesStatusText" Grid.Column="1" Grid.Row="1"
                          Text="" FontSize="10" Foreground="#556677"/>
              </Grid>

              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <Button x:Name="AnalyzeArchitectureBtn" Grid.Column="0" Grid.RowSpan="2"
                        Content="Architecture" Click="OnHypothesisClick" Padding="14,6" HorizontalAlignment="Left" Margin="0,0,12,0"/>
                <TextBlock x:Name="AnalyzeArchitectureAvailabilityText" Grid.Column="1" Grid.Row="0"
                          Text="" FontSize="11" Foreground="#AABBCC" Margin="0,0,0,2"/>
                <TextBlock x:Name="AnalyzeArchitectureStatusText" Grid.Column="1" Grid.Row="1"
                          Text="" FontSize="10" Foreground="#556677"/>
              </Grid>

              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <Button x:Name="AnalyzeReplayLogsBtn" Grid.Column="0" Grid.RowSpan="2"
                        Content="Replay Logs" Click="OnImportLogClick" Padding="14,6" HorizontalAlignment="Left" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Grid.Row="0" Text="Available always" FontSize="11" Foreground="#AABBCC" Margin="0,0,0,2"/>
                <TextBlock Grid.Column="1" Grid.Row="1" Text="Import and replay log files." FontSize="10" Foreground="#556677"/>
              </Grid>

              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <Button x:Name="AnalyzeDevConsoleBtn" Grid.Column="0" Grid.RowSpan="2"
                        Content="Dev Console" Click="OnDevConsoleClick" Padding="14,6" HorizontalAlignment="Left" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Grid.Row="0" Text="Available always" FontSize="11" Foreground="#AABBCC" Margin="0,0,0,2"/>
                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <TextBlock Text="Open diagnostics window." FontSize="10" Foreground="#556677" VerticalAlignment="Center"/>
                  <CheckBox x:Name="AnalyzeDevConsoleAutoStartCheckBox" Content="Autostart"
                            FontSize="10" Foreground="#AABBCC"
                            IsCheckedChanged="OnDevConsoleAutoStartChanged"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </DockPanel>
        </Grid>

        <!-- ── Code tab ─── -->
        <Grid x:Name="CodePanel" IsVisible="False" Background="#0F141E">
          <ContentControl x:Name="CodeBrowserHost"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"/>
        </Grid>

        <!-- ── Docs tab ─── -->
        <Grid x:Name="DocsPanel" IsVisible="False" Background="#0F141E">
          <ContentControl x:Name="DocsBrowserHost"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"/>
        </Grid>

        <!-- ── 1-column workspace layout ─── -->
        <Grid x:Name="WorkspaceGrid" IsVisible="False">

          <!-- Center Panel: Graph / System Map tabs -->
          <Border Background="#0F141E" ClipToBounds="True">
            <TabControl x:Name="CenterTabControl"
                        SelectionChanged="OnCenterTabSelectionChanged"
                        Background="Transparent"
                        BorderThickness="0,0,0,1"
                        BorderBrush="#2A3F5A">
              <TabItem Header="System Map">
                <ContentControl x:Name="SystemMapHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
              </TabItem>
              <TabItem Header="Graph">
                <ContentControl x:Name="CanvasHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
              </TabItem>
            </TabControl>
          </Border>

        </Grid>

        <!-- ── Welcome / Recent Workspaces overlay ─── -->
        <Grid x:Name="WelcomeOverlay" Background="#0F141E" IsVisible="True">
          <DockPanel Margin="60,40">

            <!-- Header row -->
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,28">
              <TextBlock Text="codomon" FontSize="32" FontWeight="Bold" Foreground="#AABBCC"/>
              <TextBlock Text="Recent Workspaces" FontSize="20" Foreground="#778899"/>
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                <Button Content="✚  New Workspace"  Click="OnNewWorkspaceClick"  Padding="14,6" FontSize="13"/>
                <Button Content="📂  Open Workspace" Click="OnOpenWorkspaceClick" Padding="14,6" FontSize="13"/>
              </StackPanel>
            </StackPanel>

            <!-- Separator -->
            <Border DockPanel.Dock="Top" Height="1" Background="#2A3F5A" Margin="0,0,0,16"/>

            <!-- Recent workspaces list -->
            <ScrollViewer>
              <ListBox x:Name="RecentWorkspacesListBox"
                      Background="Transparent"
                      SelectionChanged="OnRecentWorkspaceSelected">
                <!-- Items populated from code-behind -->
              </ListBox>
            </ScrollViewer>

          </DockPanel>
        </Grid>

        <Grid x:Name="WorkspaceLoadingOverlay"
              IsVisible="False"
              ZIndex="20"
              Background="#B20B1018">
          <Border Width="420"
                  Padding="22"
                  CornerRadius="14"
                  BorderThickness="1"
                  BorderBrush="#2A3F5A"
                  Background="#16202D"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <StackPanel Spacing="12">
              <TextBlock Text="Opening workspace..."
                         FontSize="20"
                         FontWeight="SemiBold"
                         Foreground="#E7EEF9"/>
              <ProgressBar x:Name="WorkspaceLoadingProgressBar"
                           Height="10"
                           Minimum="0"
                           Maximum="100"
                           Value="0"/>
              <TextBlock x:Name="WorkspaceLoadingStatusText"
                         Text="Preparing workspace..."
                         FontSize="13"
                         Foreground="#9CC6FF"/>
            </StackPanel>
          </Border>
        </Grid>

        </Grid><!-- end content area Grid.Column="1" -->

      </Grid><!-- end main content row 0 -->

  </Grid><!-- end resizable outer Grid -->

  </DockPanel>
</Window>
