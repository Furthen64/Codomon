<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Codomon.Desktop.Views.ArchitectureHypothesisDialog"
        Title="Architecture Hypothesis"
        Width="820" Height="640"
        MinWidth="640" MinHeight="480"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#111820">

  <DockPanel LastChildFill="True">

    <!-- Header bar -->
    <Border DockPanel.Dock="Top" Background="#1E2A3A"
            BorderThickness="0,0,0,1" BorderBrush="#2A3F5A" Padding="16,12">
      <StackPanel Spacing="2">
        <TextBlock Text="Architecture Hypothesis" FontSize="16" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="Run an LLM synthesis pass over Markdown summaries to infer Systems, Modules, and high-value Nodes."
                   FontSize="12" Foreground="#88AABB" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- Bottom button bar -->
    <Border DockPanel.Dock="Bottom" Background="#1E2A3A"
            BorderThickness="0,1,0,0" BorderBrush="#2A3F5A" Padding="16,10">
      <StackPanel Spacing="8">
        <DockPanel>
          <Button Content="Close" Click="OnCloseClick" Padding="16,6" DockPanel.Dock="Left"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="BackStepButton" Content="← Back" Click="OnBackStepClick" Padding="12,6"/>
            <Button x:Name="NextStepButton" Content="Next →" Click="OnNextStepClick" Padding="12,6" Background="#1A3A5A" Foreground="White"/>
            <Border Width="1" Margin="4,0" Background="#2A3F5A"/>
            <Button x:Name="ApplyToCanvasFooterButton" Content="✓ Apply to Canvas"
                    Click="OnApplyToCanvasClick" Padding="14,6" IsEnabled="False"
                    Background="#1A3A2A" Foreground="#AAFFAA"/>
          </StackPanel>
        </DockPanel>
        <TextBlock x:Name="StatusText" Text="" Foreground="#88AABB" FontSize="11"/>
      </StackPanel>
    </Border>

    <!-- Tab content -->
    <TabControl x:Name="WizardTabs" Background="#111820">

      <!-- ── Tab 1: Setup ───────────────────────────────────────────────── -->
      <TabItem Header="Setup">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,18" Spacing="16">

            <StackPanel Spacing="4">
              <TextBlock Text="LLM Settings" Foreground="#AABBCC" FontWeight="SemiBold"/>
              <TextBlock Text="Uses the same endpoint and model configured in the LLM Summaries dialog."
                         Foreground="#556677" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock x:Name="LlmSettingsInfoText" Text="" Foreground="#88AABB" FontSize="11"/>
            </StackPanel>

            <Border Height="1" Background="#2A3F5A"/>

            <!-- Hypothesis Prompt Editor -->
            <StackPanel Spacing="6">
              <TextBlock Text="Synthesis Prompt (hypothesis_prompt.md)" Foreground="#AABBCC" FontWeight="SemiBold"/>
              <TextBlock Text="This prompt is sent to the LLM with all summaries appended. Use {Summaries} as the placeholder for the combined summary text. The LLM must return structured JSON."
                         Foreground="#556677" FontSize="11" TextWrapping="Wrap"/>
              <Border Background="#0F141E" BorderBrush="#2A3F5A" BorderThickness="1" CornerRadius="4" Padding="10,8">
                <StackPanel Spacing="8">
                  <TextBlock Text="Preset Prompt Templates" Foreground="#AABBCC" FontWeight="SemiBold" FontSize="12"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="PromptTemplateComboBox"
                              Width="280"
                              SelectionChanged="OnPromptTemplateSelectionChanged"/>
                  </StackPanel>
                  <TextBlock x:Name="PromptTemplateDescriptionText"
                             Text=""
                             Foreground="#88AABB"
                             FontSize="11"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <TextBox x:Name="PromptBox"
                       AcceptsReturn="True"
                       MinHeight="200"
                       MaxHeight="340"
                       FontFamily="Monospace"
                       FontSize="11"
                       Background="#0F141E"
                       Foreground="#CCDDEE"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save Prompt" Click="OnSavePromptClick" Padding="12,4"/>
              </StackPanel>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Tab 2: Run ─────────────────────────────────────────────────── -->
      <TabItem Header="Run">
        <DockPanel Margin="0">

          <!-- Toolbar -->
          <Border DockPanel.Dock="Top" Background="#1A2435" Padding="12,8"
                  BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="RunButton" Content="▶ Run Synthesis"
                      Click="OnRunSynthesisClick" Padding="10,4"
                      Background="#1A3A2A" Foreground="White"/>
              <Button x:Name="CancelButton" Content="⏹ Cancel"
                      Click="OnCancelClick" Padding="10,4" IsEnabled="False"/>
              <Border Width="1" Margin="4,0" Background="#2A3F5A"/>
              <Button Content="↺ Refresh History" Click="OnRefreshHistoryClick" Padding="10,4"/>
              <Button x:Name="HistoryLoadButton" Content="▶ Load Selected"
                      Click="OnLoadSelectedHistoryClick" Padding="10,4" IsEnabled="False"
                      Background="#1A3A5A" Foreground="White"/>
            </StackPanel>
          </Border>

          <!-- Telemetry card — shown while running or after completion -->
          <Border x:Name="TelemetryCard" DockPanel.Dock="Top"
                  Background="#0F1A28" BorderBrush="#2A3F5A" BorderThickness="0,0,0,1"
                  Padding="12,8" IsVisible="False">
            <StackPanel Spacing="8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: batch / summary / time -->
                <StackPanel Grid.Column="0" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="TelemetryStateLabel"
                               Text="Running" FontWeight="SemiBold"
                               Foreground="#AADDCC" FontSize="12"/>
                    <TextBlock x:Name="TelemetryBatchLabel"
                               Text="Batch — / —" Foreground="#88AABB" FontSize="11"/>
                    <TextBlock x:Name="TelemetrySummariesLabel"
                               Text="Summaries: —" Foreground="#88AABB" FontSize="11"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="TelemetryElapsedLabel"
                               Text="Elapsed: —" Foreground="#667788" FontSize="11"/>
                    <TextBlock x:Name="TelemetryEtaLabel"
                               Text="ETA: —" Foreground="#667788" FontSize="11"/>
                  </StackPanel>
                </StackPanel>

                <!-- Right: token counts / speed -->
                <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="TelemetryPromptTokLabel"
                               Text="Prompt tok: —" Foreground="#667788" FontSize="11"/>
                    <TextBlock x:Name="TelemetryOutputTokLabel"
                               Text="Output tok: —" Foreground="#667788" FontSize="11"/>
                  </StackPanel>
                  <TextBlock x:Name="TelemetrySpeedLabel"
                             Text="Speed: —" Foreground="#556677" FontSize="10"
                             HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>

              <Border x:Name="TokenBudgetWarningPanel"
                      IsVisible="False"
                      Background="#3A2912"
                      BorderBrush="#CCAA44"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="8,6">
                <TextBlock x:Name="TokenBudgetWarningText"
                           Foreground="#FFDD88"
                           FontSize="11"
                           TextWrapping="Wrap"/>
              </Border>
            </StackPanel>
          </Border>

          <!-- Split: progress log (left) | history + batch log (right) -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="280" MinWidth="180"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Progress log + Live Output expander -->
            <DockPanel Grid.Column="0">
              <Border DockPanel.Dock="Top" Padding="8,6" Background="#1A2435">
                <TextBlock Text="Progress" FontWeight="Bold" Foreground="#AABBCC" FontSize="12"/>
              </Border>

              <!-- Live LLM Output expander — collapsed by default -->
              <Expander x:Name="LiveOutputExpander"
                        DockPanel.Dock="Bottom"
                        Header="Live LLM Output"
                        IsExpanded="False"
                        Background="#0A1018"
                        Foreground="#AABBCC"
                        BorderBrush="#2A3F5A"
                        BorderThickness="0,1,0,0">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                              Margin="8,4,8,0">
                    <TextBlock x:Name="LiveOutputCharCountLabel"
                               Text="0 chars" Foreground="#556677" FontSize="10"/>
                    <Button x:Name="LiveOutputCopyButton" Content="Copy" Padding="6,2"
                            FontSize="10" Click="OnCopyLiveOutputClick"/>
                  </StackPanel>
                  <Border Margin="8,4" MaxHeight="160"
                          Background="#070D14" BorderBrush="#2A3F5A" BorderThickness="1"
                          CornerRadius="3">
                    <ScrollViewer x:Name="LiveOutputScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                      <TextBlock x:Name="LiveOutputText"
                                 FontFamily="Monospace" FontSize="10"
                                 Foreground="#AABBCC"
                                 TextWrapping="Wrap"
                                 Margin="6,4"/>
                    </ScrollViewer>
                  </Border>
                </DockPanel>
              </Expander>

              <!-- Progress log -->
              <Border Background="#0F141E" BorderBrush="#2A3F5A" BorderThickness="1" Margin="8">
                <ListBox x:Name="ProgressListBox"
                         Background="Transparent"
                         FontFamily="Monospace"
                         FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
              </Border>
            </DockPanel>

            <!-- Right: Batch log + Hypothesis history -->
            <Border Grid.Column="1" BorderBrush="#2A3F5A" BorderThickness="1,0,0,0">
              <DockPanel>

                <!-- Batch log -->
                <DockPanel DockPanel.Dock="Top">
                  <Border DockPanel.Dock="Top" Padding="8,6" Background="#1A2435"
                          BorderBrush="#2A3F5A" BorderThickness="0,0,0,1">
                    <TextBlock Text="Batch Log" FontWeight="Bold" Foreground="#AABBCC" FontSize="12"/>
                  </Border>
                  <ListBox x:Name="BatchLogListBox"
                           Background="Transparent"
                           MaxHeight="180"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </DockPanel>

                <!-- Hypothesis history -->
                <Border DockPanel.Dock="Top" Padding="8,6" Background="#1A2435"
                        BorderBrush="#2A3F5A" BorderThickness="0,1,0,1">
                  <TextBlock Text="History" FontWeight="Bold" Foreground="#AABBCC" FontSize="12"/>
                </Border>
                <ListBox x:Name="HistoryListBox"
                         Background="Transparent"
                         DoubleTapped="OnHistoryDoubleTapped"
                         SelectionChanged="OnHistorySelectionChanged"/>

                <Border DockPanel.Dock="Bottom"
                        Padding="10,8"
                        Background="#0E1622"
                        BorderBrush="#2A3F5A"
                        BorderThickness="0,1,0,0">
                  <StackPanel Spacing="4">
                    <TextBlock Text="What Codomon is building"
                               Foreground="#AABBCC"
                               FontWeight="SemiBold"
                               FontSize="12"/>
                    <TextBlock Text="Architecture Synthesis infers systems, modules, boundaries, relationships, and architectural anchors from generated summaries."
                               Foreground="#88AABB"
                               FontSize="10"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="After synthesis you can review inferred systems, refine names and boundaries, confirm relationships, and apply updates to the canvas."
                               Foreground="#667788"
                               FontSize="10"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DockPanel>
            </Border>

          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ── Tab 3: Systems ─────────────────────────────────────────────── -->
      <TabItem Header="Systems" x:Name="SystemsTab">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#1A2435" Padding="12,8"
                  BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
            <DockPanel>
              <TextBlock x:Name="SystemsHeaderText"
                         Text="Suggested Systems — run or load a hypothesis first."
                         Foreground="#556677" FontSize="11" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right">
                <Button Content="Save Markdown Overview" Click="OnSaveMarkdownOverviewClick" Padding="10,4"/>
                <Border Width="1" Margin="2,0" Background="#2A3F5A"/>
                <Button x:Name="AcceptSelectedSystemButton" Content="Accept Selected"
                        Click="OnAcceptSelectedSystemFromTabClick" Padding="10,4" IsEnabled="False"
                        Background="#1A3A5A" Foreground="White"/>
                <Button x:Name="AcceptAllLikelySystemsButton" Content="Accept All Likely"
                        Click="OnAcceptAllLikelySystemsClick" Padding="10,4"
                        Background="#1A3A2A" Foreground="White"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <ListBox x:Name="SystemsListBox" Background="Transparent"
                   SelectionChanged="OnSystemsListSelectionChanged"/>
        </DockPanel>
      </TabItem>

      <!-- ── Tab 4: High-Value Nodes ────────────────────────────────────── -->
      <TabItem Header="Architecture Anchors" x:Name="HvnTab">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#1A2435" Padding="12,8"
                  BorderThickness="0,0,0,1" BorderBrush="#2A3F5A">
            <DockPanel>
              <TextBlock x:Name="HvnHeaderText"
                         Text="High-Value Node suggestions — run or load a hypothesis first."
                         Foreground="#556677" FontSize="11" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Right">
                <Button x:Name="AcceptSelectedNodeButton" Content="Accept Selected"
                        Click="OnAcceptSelectedNodeFromTabClick" Padding="10,4" IsEnabled="False"
                        Background="#1A3A5A" Foreground="White"/>
                <Button x:Name="AcceptAllLikelyNodesButton" Content="Accept All Likely"
                        Click="OnAcceptAllLikelyNodesClick" Padding="10,4"
                        Background="#1A3A2A" Foreground="White"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <ListBox x:Name="HvnListBox" Background="Transparent"
                   SelectionChanged="OnHvnListSelectionChanged"/>
        </DockPanel>
      </TabItem>

      <!-- ── Tab 5: Confirm & Apply ─────────────────────────────────────── -->
      <TabItem Header="Confirm &amp; Apply">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,16" Spacing="16">

            <TextBlock Text="Accept Suggestions into System Map"
                       Foreground="#AABBCC" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock Text="Accepted items are added to your workspace System Map. They remain editable and are not overwritten on subsequent synthesis passes."
                       Foreground="#556677" FontSize="11" TextWrapping="Wrap"/>

            <Border Height="1" Background="#2A3F5A"/>

            <!-- Quick actions -->
            <StackPanel Spacing="6">
              <TextBlock Text="Quick Actions" Foreground="#AABBCC" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Accept All Likely Systems"
                        Click="OnAcceptAllLikelySystemsClick" Padding="12,4"
                        Background="#1A3A2A" Foreground="White"/>
                <Button Content="Accept All Likely Nodes"
                        Click="OnAcceptAllLikelyNodesClick" Padding="12,4"
                        Background="#1A3A2A" Foreground="White"/>
              </StackPanel>
            </StackPanel>

            <Border Height="1" Background="#2A3F5A"/>

            <!-- Accept Systems -->
            <StackPanel Spacing="8">
              <TextBlock Text="Systems" Foreground="#AABBCC" FontWeight="SemiBold"/>
              <ListBox x:Name="AcceptSystemsListBox" Background="Transparent" MinHeight="60"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Accept / Merge Selected System"
                        Click="OnAcceptSystemClick" Padding="12,4"
                        Background="#1A3A5A" Foreground="White"/>
              </StackPanel>
            </StackPanel>

            <Border Height="1" Background="#2A3F5A"/>

            <!-- Accept High-Value Nodes -->
            <StackPanel Spacing="8">
              <TextBlock Text="High-Value Nodes" Foreground="#AABBCC" FontWeight="SemiBold"/>
              <ListBox x:Name="AcceptHvnListBox" Background="Transparent" MinHeight="60"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Accept / Merge Selected Node"
                        Click="OnAcceptNodeClick" Padding="12,4"
                        Background="#1A3A5A" Foreground="White"/>
              </StackPanel>
            </StackPanel>

            <Border Height="1" Background="#2A3F5A"/>

            <!-- Uncertain Areas -->
            <StackPanel Spacing="6">
              <TextBlock Text="Uncertain / Ambiguous Areas" Foreground="#AABBCC" FontWeight="SemiBold"/>
              <ListBox x:Name="UncertainListBox" Background="Transparent" MinHeight="40"/>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ── Tab 6: Finish ──────────────────────────────────────────────────── -->
      <TabItem Header="Finish">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,16" Spacing="16">

            <TextBlock Text="Finish &amp; Apply to Canvas"
                       Foreground="#AABBCC" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock Text="Apply accepted items to the System Map canvas. Optionally clear the current canvas first to start from a clean slate."
                       Foreground="#556677" FontSize="11" TextWrapping="Wrap"/>

            <Border Height="1" Background="#2A3F5A"/>

            <TextBlock x:Name="FinishSummaryText"
                       Foreground="#88AABB" FontSize="12" TextWrapping="Wrap"
                       Text="No items accepted yet. Go to the Accept tab to accept suggestions."/>

            <Border Height="1" Background="#2A3F5A"/>

            <StackPanel Spacing="8">
              <TextBlock Text="Canvas Actions" Foreground="#AABBCC" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Clear current canvas"
                        Click="OnClearCanvasClick" Padding="12,6"
                        Background="#3A1A1A" Foreground="#FFAAAA"/>
                <Button Content="Apply to Canvas"
                        Click="OnApplyToCanvasClick" Padding="12,6"
                        Background="#1A3A2A" Foreground="#AAFFAA"/>
              </StackPanel>
              <TextBlock Text="'Apply to Canvas' closes this dialog and refreshes the System Map view."
                         Foreground="#445566" FontSize="10" TextWrapping="Wrap"/>
              <TextBlock Text="'Clear current canvas' removes all existing Systems, Modules, External Systems and Relationships from the canvas (Manual Overrides are preserved)."
                         Foreground="#445566" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

  </DockPanel>
</Window>
