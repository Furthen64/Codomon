<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Codomon.Desktop.Views.TechStackScanDialog"
        Title="Tech Stack"
        Width="720" Height="560"
        MinWidth="600" MinHeight="460"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#111820">

  <DockPanel LastChildFill="True">

    <Border DockPanel.Dock="Top" Background="#1E2A3A"
            BorderThickness="0,0,0,1" BorderBrush="#2A3F5A" Padding="16,12">
      <DockPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="Tech stack" FontSize="16" FontWeight="Bold" Foreground="White"/>
          <TextBlock x:Name="StepTitleText" Text="Ready to scan"
                     FontSize="12" Foreground="#88AABB"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#1E2A3A"
            BorderThickness="0,1,0,0" BorderBrush="#2A3F5A" Padding="16,10">
      <DockPanel>
        <Button x:Name="CloseButton" Content="Close" Click="OnCloseClick"
                Padding="16,6" DockPanel.Dock="Left"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="CancelScanButton" Content="Cancel"
                  Click="OnCancelScanClick"
                  Padding="16,6" IsVisible="False"/>
          <Button x:Name="StartScanButton" Content="Scan"
                  Click="OnStartScanClick"
                  Padding="16,6" IsEnabled="False"/>
          <Button x:Name="ViewResultsButton" Content="Results"
                  Click="OnViewResultsClick"
                  Padding="16,6" IsVisible="False"/>
          <Button x:Name="RescanButton" Content="Scan again"
                  Click="OnRescanClick"
                  Padding="16,6" IsVisible="False"/>
          <Button x:Name="OkButton" Content="Done"
                  Click="OnCloseClick"
                  Padding="16,6" IsVisible="False"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Padding="0">
      <Grid>

        <DockPanel x:Name="PreflightPanel" Margin="24,20" IsVisible="True">
          <StackPanel DockPanel.Dock="Top" Spacing="14">
            <Border Background="#0F141E" BorderBrush="#2A3F5A" BorderThickness="1"
                    CornerRadius="4" Padding="14,12">
              <StackPanel Spacing="8">
                <TextBlock x:Name="PreflightStatusIcon" Text="⏳" FontSize="20"/>
                <TextBlock x:Name="PreflightMessageText"
                           Text="Running preflight check…"
                           Foreground="#AABBCC" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </DockPanel>

        <DockPanel x:Name="ScanningPanel" Margin="24,16" IsVisible="False" LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
            <TextBlock x:Name="ScanningStatusText" Text="Scanning…"
                       Foreground="#AABBCC" TextWrapping="Wrap"/>
            <ProgressBar x:Name="ScanningProgressBar" IsIndeterminate="True" Height="4"/>
          </StackPanel>
        </DockPanel>

        <Grid x:Name="ResultsPanel" IsVisible="False">
          <DockPanel>
            <Border x:Name="RestoredScanBanner"
                    DockPanel.Dock="Top"
                    IsVisible="False"
                    Margin="12,10,12,0"
                    Padding="10,8"
                    Background="#1A3B2A"
                    BorderBrush="#2D7A55"
                    BorderThickness="1"
                    CornerRadius="4">
              <TextBlock x:Name="RestoredScanBannerText"
                         Text=""
                         Foreground="#CDEEDB"
                         FontSize="11"
                         TextWrapping="Wrap"/>
            </Border>

            <StackPanel DockPanel.Dock="Top" Margin="12,10,12,0" Spacing="8">
              <TextBlock x:Name="ResultsSummaryText"
                         Text="No technologies loaded."
                         Foreground="#AABBCC"
                         FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="90,*">
                <TextBlock Grid.Column="0" Text="Project" Foreground="#778899" VerticalAlignment="Center"/>
                <ComboBox x:Name="ProjectFilterComboBox"
                          Grid.Column="1"
                          SelectionChanged="OnProjectFilterSelectionChanged"/>
              </Grid>
            </StackPanel>

            <DockPanel DockPanel.Dock="Bottom" Margin="12,10" LastChildFill="True" Height="240">
              <TextBlock DockPanel.Dock="Top" x:Name="DetailTitleText"
                         Text="Select a technology to view details."
                         Foreground="#778899" FontSize="12" Margin="0,0,0,8"/>
              <ScrollViewer>
                <StackPanel x:Name="DetailStackPanel" Spacing="6"/>
              </ScrollViewer>
            </DockPanel>

            <Border Margin="12,10,12,0"
                    BorderBrush="#2A3F5A" BorderThickness="1" CornerRadius="4">
              <DockPanel>
                <Border DockPanel.Dock="Top" Padding="10,7" Background="#1A2435">
                  <TextBlock Text="Technologies"
                             FontWeight="Bold" Foreground="#AABBCC" FontSize="12"/>
                </Border>
                <ListBox x:Name="TechnologyListBox"
                         Background="Transparent"
                         SelectionChanged="OnTechnologySelectionChanged"/>
              </DockPanel>
            </Border>
          </DockPanel>
        </Grid>
      </Grid>
    </Border>

  </DockPanel>
</Window>
