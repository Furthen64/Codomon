<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Codomon.Desktop.Views.StaticSplashWindow"
        Width="840" Height="480"
        CanResize="False"
        SystemDecorations="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#0F1422">
  <Grid Margin="32">
    <Border Background="#111A2D" BorderBrush="#2E4068" BorderThickness="1" CornerRadius="6"/>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
      <TextBlock Text="codomon" FontSize="52" FontWeight="Bold" Foreground="#EFF3FF" HorizontalAlignment="Center"/>
      <TextBlock Text="Loading architecture workspace..." FontSize="18" Foreground="#A8B7D8" HorizontalAlignment="Center"/>
    </StackPanel>
  </Grid>
</Window>
